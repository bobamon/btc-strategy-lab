//@version=6
// WAR FORMATION E64b - THE LONG LEG UNDER THE SAME 6H DIRECTION RULE. THE CONTROL FOR E64a.
//
// USER DIRECTIVE, 2026-09-03: War Formation must work in BOTH directions, and the 6H is the
// direction. E64a built the short. This is the OTHER HALF, and it is also the control that makes
// E64a interpretable.
//
// WHY THIS RUN IS NOT OPTIONAL. E64a changed TWO things against the reproducible parent e58a: the
// LEG (long -> short) and the DIRECTION SOURCE (4+ green 1h candles inside the prior 6h block ->
// 2+ consecutive 6h candles of one colour, which is the source's actual rule, ORACLE-RULES L204-216).
// Reading E64a alone would confound them - exactly what HARD LESSON 10 warns about. E64b holds the
// LEG at e58a's long and changes ONLY the direction source, so the two runs decompose cleanly:
//   E64b vs e58a (PF 1.24015239 / DD 9.82519609% / 36 trades) isolates the DIRECTION RULE.
//   E64a vs E64b                                             isolates the LEG.
//
// EVERYTHING ELSE IS HELD AT e58a EXACTLY - shield $1,000, cap 6480, velK 0.8, the whole-number band,
// the time gate, and the witching ban (which the source states as a LONG-side rule, so it stays here
// and is correctly absent from E64a; that asymmetry is declared, not accidental).
//
// AUDIT, one line per leg:
//   R >= 0.8% (LESSON 3) - the SHIELD, a fixed $1,000 gap; the spec's own exit model and a DECLARED
//        deviation from a structural stop. Same live tension as E64a: ~1.0% at BTC $100k, under the
//        floor above ~$125k.
//   Stop placement (LESSON 5) - risk-defined by the shield. Declared, per the spec.
//   Each leg separately (LESSON 6) - LONG ONLY. Never blended with E64a.
//   BINDING (E17) - if the trade count barely moves from e58a's 36, the two direction rules are
//        near-equivalent and the source's version is a simplification rather than an improvement.
//   REDUNDANCY (E14) - bullRegime and h1Bull both say "price is rising"; the source keeps both and
//        calls the 1h agreement a BONUS ("singularity"), not a requirement.
//   LATCH IN SEQUENCE (LESSON 8) - 6H colour fixed at block close; brokeBelow on a completed 15m
//        block; the reclaim crossover on a LATER 1m bar. No shared bar.
//   OCCUPANCY (LESSONS 24/28/29) - a different admission rule shifts entry times, so downstream
//        trades diverge and this is NOT a controlled trade-for-trade comparison against e58a.
//        Named IN ADVANCE.
//   SL and TP FIXED AT ENTRY. No trailing, no averaging down, no martingale.
//
// OUTCOMES REGISTERED BEFORE THE RUN (LESSON 17):
//   * PF >= e58a's 1.24015239 -> the source's own direction rule is BETTER than the 1h-count proxy
//     the lab invented, and the proxy should be retired. A small, source-faithful improvement.
//   * PF materially below 1.24015239 -> the 1h-count proxy was doing real work the raw 6h colour
//     does not, and that is a finding about WHY the lab drifted from the source, not a reason to
//     abandon the source rule. Report it plainly.
//   * PF still >= 1.0 -> the long leg survives the rule change, so E64a's 0.45 is about the LEG and
//     not about the direction rule being broken. That is the decomposition this run exists for.
//   * fewer than ~20 trades -> DIRECTION, not a result (LESSON 12).
strategy("War Formation E64b 6h-direction LONG", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

run6      = input.int(2,     "Consecutive 6h candles for CLEAR DIRECTION (source: more than one)")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
shieldUsd = input.float(1000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(6480,  "Max bars in trade -- held at e58a value")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET (source: LONG-side rule)")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float o6   = na
var int   grn6 = 0
var int   red6 = 0

if new6
    if not na(o6)
        if close[1] > o6
            grn6 := grn6 + 1
            red6 := 0
        else if close[1] < o6
            red6 := red6 + 1
            grn6 := 0
    o6 := open

bullRegime = grn6 >= run6

var float h1o = na
if new1h
    h1o := open

h1Bull = not na(h1o) and close > h1o

minsIn   = (time - b6 * MS6H) / 60000
timeGate = minsIn >= skipOpen and minsIn <= (360 - skipClose)

var float c15l = na
var float p15l = na

if new15
    p15l := c15l
    c15l := low
else
    c15l := na(c15l) ? low : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig = not na(p15l) and not na(velMin) and ta.crossover(close, p15l) and (close - p15l) >= velMin

goLong = bullRegime and timeGate and h1Bull and brokeBelow and not inMiddle and not longBan and longTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

longR = shieldUsd

if flat and goLong and longR > 0
    strategy.entry("L", strategy.long)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong ? 1 : 0, title="LongSignal")
plot(grn6,           title="ConsecGreen6h")
