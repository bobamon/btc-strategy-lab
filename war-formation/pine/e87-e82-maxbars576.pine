//@version=6
// WAR FORMATION E87 -- THE HOLD-CAP AXIS, NEVER SWEPT AT 15m: maxBars 288 -> 576 (3 days -> 6 days).
//
// E85's split test failed E80/E82 out-of-sample (PF 1.24 full window -> 2.77 H1 -> 0.49 H2). E86's
// no-credit trade-level diagnostic (get_trades on E84/E85, no backtest run) found the split-test
// failure is NOT explained by the location/structure gates: the admitted population was comparable
// in size both halves (20 vs 24) under byte-identical entry logic. What changed is how often an
// admitted trade traveled the FULL distance to the 2R target or the full shield before maxBars timed
// it out: H1 had 6/20 exact-target hits (30%) whose combined profit exceeded the half's entire net
// result; H2 had only 2/24 (8.3%) while exact full-shield hits nearly quadrupled (2->7). E86's own
// queue: the next idea "should not be another location/structure gate variant... but something that
// addresses how many admitted trades get the room to complete a full 2R run" -- and explicitly ruled
// out changing the shield's width or basis (a mechanism change the mandate forbids, not a tweak).
//
// THE ONE AXIS THAT FITS BOTH CONSTRAINTS: maxBars, the hold-cap timeout. It is not a location/
// structure gate (goLong/goShort are untouched) and it is not the shield's width or basis (shieldUsd/
// rr are untouched) -- it is purely how long an admitted trade is given to reach one of the two fixed
// dollar boundaries before being forced flat. This axis has been carried UNCHANGED (288 = "three
// days", the same calendar-time convention reused verbatim from E36's original 1m derivation through
// E78's 5m port and E80's 15m port) across every 15m run to date (E80-E85) specifically so other
// variables could be isolated -- it has never itself been swept on 15m data.
//
// SINGLE HYPOTHESIS, ISOLATED (HARD LESSON 16/E17): does widening the hold cap -- giving admitted
// trades more time to travel the full 2R distance before timing out -- change the balance of exact-
// target vs exact-shield vs timeout outcomes E86 diagnosed, and does that change PF/drawdown on the
// full window (the same window as E80/E82, for direct comparability)?
//
// BINDING: exactly one variable changed from e82-e80-no-h1bull-h1bear.pine (this lab's established
// minimal four-gate equivalent of E80, h1Bull/h1Bear already shown fully redundant at E82/E83):
// maxBars 288 -> 576. Every gate, threshold, atr period, shieldUsd, rr is byte-identical. Chosen as a
// clean doubling (6 days) rather than a small step, per HARD LESSON 28's own caution that a SINGLE
// data point near the anchor cannot distinguish a real relationship from noise -- a large first step
// is more informative than a small one when only one credit is available, and the direction (wider,
// not narrower) is the only one HARD LESSON 28/29's own logic supports: narrowing the cap can only
// starve MORE trades into a premature timeout, which is already the losing outcome E86 diagnosed, not
// a plausible fix for it.
//
// PRE-RUN AUDIT:
//   R = shieldUsd $2,000, same window as E80/E82 (~$60k-$120k BTC range): 1.7%-3.3%, clears the 0.8%
//     floor (HARD LESSON 3).
//   Stop is risk-defined per the ALCM spec (HARD LESSON 5), unchanged.
//   Both legs reported separately (HARD LESSON 6).
//   BINDING (E17): exactly one variable changed -- maxBars. Everything else byte-identical to E82.
//   REDUNDANCY (HARD LESSON 18): n/a, no term added or removed.
//   Latch order unchanged (HARD LESSON 8).
//   OCCUPANCY CONFOUND, NAMED IN ADVANCE (HARD LESSON 24/28/29): this IS an exit-timing change, so
//     per HARD LESSON 29 the admitted trade set is expected to diverge from E82's from the first
//     trade whose exit bar moves -- this run cannot be read as "the same 44 trades held longer." It
//     is "this construction at maxBars=288" versus "this construction at maxBars=576," aggregate
//     PF/DD/count only, not a trade-for-trade comparison. That is the entire point of the test, not
//     an incidental side effect to explain away.
//
// REGISTERED PREDICTION (HARD LESSON 17), BEFORE RUNNING: if E86's diagnosis is correct (the edge is
// concentrated in a minority of trades that catch a large enough run inside the cap, and the cap
// binding is what turns an in-progress winner into a forced flat), widening the cap should raise the
// share of trades resolving at the exact 2R target and could raise PF and/or trade count materially
// (the occupancy shift admits a different bar sequence). If the failure is instead about DIRECTION
// (H2's price path reversing against open trades) rather than TIME, widening the cap could just as
// plausibly make things worse (more time for an adverse move to reach the shield) -- this is a real
// two-sided prediction, not a one-sided hope, and is stated as such before running.
//
// RESULT, VERDICT and KEEP/REJECT are recorded in EXPERIMENT-LOG.md and results/backtests.json after
// this run completes, per the lab's provenance rule (never hand-write a metric).
strategy("War Formation E87 maxBars576", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
greenBear = input.int(2,     "Green 1h candles at or below for BEAR")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
coilK     = input.float(0.85,"Coil: atrFast < atrSlow * K")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atrSlow")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(2000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(576,   "Max bars in trade -- six days of 15m (E87: doubled from E82's 288)")

MS6H = 21600000
MS1H = 3600000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull
bearRegime  = regimeReady and grnPrev <= greenBear

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

// h1Bull/h1Bear REMOVED from this build's gates (still computed/plotted for audit, not gated on) --
// unchanged from E82/E83's established finding that they are fully redundant given brokeBelow/
// brokeAbove and cannot substitute for it.
h1Bull = not na(h1o) and close > h1o
h1Bear = not na(h1o) and close < h1o

var float c1hh = na
var float c1hl = na
var float p1hh = na
var float p1hl = na

if new1h
    p1hh := c1hh
    p1hl := c1hl
    c1hh := high
    c1hl := low
else
    c1hh := na(c1hh) ? high : math.max(c1hh, high)
    c1hl := na(c1hl) ? low  : math.min(c1hl, low)

brokeBelow = not na(p1hl) and c1hl < p1hl
brokeAbove = not na(p1hh) and c1hh > p1hh

atrFast = ta.atr(1)
atrSlow = ta.atr(2)
coiled  = not na(atrSlow) and atrSlow > 0 and atrFast < atrSlow * coilK
coilPrev = coiled[1]
velMin   = na(atrSlow) ? na : atrSlow * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p1hl) and not na(velMin) and ta.crossover(close, p1hl)  and (close - p1hl) >= velMin
shortTrig = not na(p1hh) and not na(velMin) and ta.crossunder(close, p1hh) and (p1hh - close) >= velMin

goLong  = bullRegime and timeGate and brokeBelow and coilPrev and not inMiddle and not longBan and longTrig
goShort = bearRegime and timeGate and brokeAbove and coilPrev and not inMiddle and shortTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

if flat and goLong
    strategy.entry("L", strategy.long)
    slPx   := close - shieldUsd
    tpPx   := close + shieldUsd * rr
    barsIn := 0

if flat and goShort
    strategy.entry("S", strategy.short)
    slPx   := close + shieldUsd
    tpPx   := close - shieldUsd * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong  ? 1 : 0, title="LongSignal")
plot(goShort ? 1 : 0, title="ShortSignal")
