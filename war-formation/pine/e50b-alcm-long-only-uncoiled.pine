//@version=6
// WAR FORMATION E50b — THE CONSTRUCTION E46/E47 ACTUALLY CLAIMED TO BE, BUILT FOR THE FIRST TIME.
//
// E46's log entry describes "uncoiled longs, no short leg" (PF 0.92509109, 25 trades). E47 describes
// itself as the same construction with maxBars raised 4320 -> 12960 (PF 1.21869905, 21 trades). Neither
// claim matches the code that was actually saved: e47-alcm-long-cap12960.pine keeps coilPrev in goLong
// (identical to alcm-reference.pine's E44 anchor, coil on BOTH legs) and, per E49, keeps the full short
// leg alive too. e50a (this pair's sibling) deletes the short leg but deliberately keeps coilPrev, to
// isolate that one variable. THIS FILE additionally removes coilPrev from goLong -- the genuinely
// uncoiled, no-short-leg build that E46 and E47 have described in prose since 2026-09-02 but that has
// never actually been run.
//
// PRE-REGISTERED OUTCOME (HARD LESSON 17), against e50a as the immediate comparison:
//   - Similar trade count and PF to e50a -> coilPrev does not actually bind on this population at
//     maxBars=12960, so the mislabeling was real but empirically harmless, and E46/E47's headline
//     numbers happen to still describe this construction's neighbourhood.
//   - Meaningfully more trades and/or a different PF -> coilPrev DOES bind here (consistent with E45's
//     finding that the coil is a liability on the long leg), and E46/E47's PF 0.925 / 1.219 headline
//     numbers never actually measured the "uncoiled" construction the log has attributed them to since
//     E46 -- that number needs to be re-derived from THIS file, not from e47's.
//
// THE SPECIFICATION: War Formation has NO STOP LOSS. The exit is the A.L.C.M. shield -- a fixed dollar
// gap to liquidation. The position ends at target or at liquidation. NEVER add to a losing trade.
//
// PRE-RUN AUDIT:
//   LONG (only leg) -- R = shieldUsd = $2,000, ~2% of BTC price: PASSES the 0.8% floor (HARD LESSON 3).
//     Stop is RISK-DEFINED, not structural -- the declared ALCM deviation from HARD LESSON 5. SL/TP
//     fixed at entry, no trailing. Latch order: 15m level breaks (brokeBelow), then the 1m reclaim
//     fires (HARD LESSON 8). coilPrev term REMOVED here -- this is the binding test HARD LESSON 15
//     requires (apply it to signal terms, not only filters): E45 already showed coiled-vs-uncoiled
//     flips the long leg's ranking (E43 uncoiled 0.923 best-of-set vs E44 coiled 0.346 worst-of-set on
//     the OLD 4320 cap); this is the first time that binding test is repeated on the corrected cap.
//   SHORT -- DELETED (identical to e50a): no short entry can fire; position_size can never be negative.
//   Redundancy (HARD LESSON 18): removing coilPrev leaves atrFast/atrSlow/coilK/coiled entirely unused,
//     so they are deleted too, not left dead in the file.
//
// SAMPLE CEILING: ~3 days per trade across 4.5 months of 1m data (2025-12-16 to 2026-05-03) caps this
// family near 20-30 trades. A ratio below ~20 trades is reported as a COUNT, not read as a result.
strategy("War Formation E50b long-only uncoiled cap12960", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(2000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(12960, "Max bars in trade -- nine days, per E47")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o

var float c15l = na
var float p15l = na

if new15
    p15l := c15l
    c15l := low
else
    c15l := na(c15l) ? low : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p15l) and not na(velMin) and ta.crossover(close, p15l) and (close - p15l) >= velMin

goLong  = bullRegime and timeGate and h1Bull and brokeBelow and not inMiddle and not longBan and longTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

longR = shieldUsd

if flat and goLong and longR > 0
    strategy.entry("L", strategy.long)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong ? 1 : 0, title="LongSignal")
