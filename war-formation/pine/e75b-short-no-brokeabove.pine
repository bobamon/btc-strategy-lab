//@version=6
// WAR FORMATION E75b - THE SHORT WITHOUT brokeAbove. THIRD BINDING TEST ON THIS LEG.
// E71 byte-identical with ONE term removed: brokeAbove (the current 15m high must exceed the prior
// completed 15m high -- "let the Red Army finish", the source's own central teaching). On the LONG the
// mirror term brokeBelow was the source's CENTRAL teaching and it bound hard there too (E70a: PF
// 1.240 -> 1.036 when removed, +23 trades). This tests whether the location thesis carries to the
// short leg the way h1/band did NOT (E74 found the band long-oriented; E75a tests h1Bear separately).
// Single-term removal from E71 (PF 0.97315988 / DD 2.66826642%% / 33 trades / 36.36363636%% win), the
// established parent for short-leg binding tests.
// AUDIT: shield 1000 is 1.2-1.6%% of price (LESSON 3); risk-defined stop is the ALCM declared
// deviation, NO stop loss (LESSON 5); SHORT leg alone (LESSON 6 scoped); THIS IS A BINDING TEST -- an
// unchanged count AND win/loss split would mean the term is INERT here (E17, HARD LESSON 44); removing
// a term cannot add overlap (E14); latches unchanged from E71 (LESSON 8); OCCUPANCY NAMED - removing a
// ban ADMITS entries so the count should RISE from 33, but pyramiding=1 means an earlier entry can
// BLOCK a later one so the population is NOT a clean superset (LESSONS 24/28/29); expect cascadeRatio 1
// (LESSON 35). SL and TP FIXED AT ENTRY. No trailing, no averaging down, no martingale.
strategy("War Formation E64a 6h-direction SHORT", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

run6      = input.int(2,     "Consecutive 6h candles for CLEAR DIRECTION (source: more than one)")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min rejection as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
shieldUsd = input.float(1000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
eqFrac    = input.float(0.25,"DECLARED DEVIATION: fraction of equity per position -- HARD LESSON 42")
maxBars   = input.int(6480,  "Max bars in trade -- held at e58a value")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float o6   = na
var int   grn6 = 0
var int   red6 = 0

if new6
    if not na(o6)
        if close[1] > o6
            grn6 := grn6 + 1
            red6 := 0
        else if close[1] < o6
            red6 := red6 + 1
            grn6 := 0
    o6 := open

bearRegime = red6 >= run6

var float h1o = na
if new1h
    h1o := open

h1Bear = not na(h1o) and close < h1o

minsIn   = (time - b6 * MS6H) / 60000
timeGate = minsIn >= skipOpen and minsIn <= (360 - skipClose)

var float c15h = na
var float p15h = na

if new15
    p15h := c15h
    c15h := high
else
    c15h := na(c15h) ? high : math.max(c15h, high)

brokeAbove = not na(p15h) and c15h > p15h

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

shortTrig = not na(p15h) and not na(velMin) and ta.crossunder(close, p15h) and (p15h - close) >= velMin

// THE ONE CHANGE: "and brokeAbove" is REMOVED from the line below.
goShort = bearRegime and timeGate and h1Bear and not inMiddle and shortTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

shortR = shieldUsd
qtyUse = strategy.equity * eqFrac / close

if flat and goShort and shortR > 0 and qtyUse > 0
    strategy.entry("S", strategy.short, qty = qtyUse)
    slPx   := close + shortR
    tpPx   := close - shortR * rr
    barsIn := 0

if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goShort ? 1 : 0, title="ShortSignal")
plot(red6,            title="ConsecRed6h")
