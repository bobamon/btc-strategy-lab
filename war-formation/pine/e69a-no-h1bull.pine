//@version=6
// WAR FORMATION E69a - BINDING TEST: DOES h1Bull DO ANYTHING? THE SOURCE CALLS IT A BONUS.
//
// WHY THIS AND NOT THE SHORT LEG. The stored prompt's queue item 1 says to attack the short's entry
// geometry. THE DOCS OVERRIDE THAT and I am following the docs. E68 established that a short sized at
// 100% of equity is force-closed at ~0.35% adverse, below the 0.8% that commission alone requires
// (HARD LESSON 3), so NO short stop can ever fire on this engine at this sizing. Any short number
// this lab produces measures the engine's margin behaviour, not War Formation. E68's own rewritten
// queue says it plainly: "Stop spending credits on War Formation short geometries. Any result is
// uninterpretable." So this cycle runs queue item 2 - the long-side entry terms, the only legitimate
// axis left in this lab.
//
// THE TERM UNDER TEST, AND WHY IT IS FIRST. `h1Bull` requires the CURRENT price to be above the
// CURRENT 1h candle's open. It sits alongside `bullRegime` (4+ green 1h candles inside the PRIOR
// completed 6h block). Both say "price is rising", which makes them prime E14 redundancy suspects -
// AND THE SOURCE ITSELF CALLS THIS TERM OPTIONAL. ORACLE-RULES L211: "Singularity = 6h and 1h the
// same colour. A bonus, not a requirement." So removing it is not a liberty taken with the user's
// strategy; it tests a term the source explicitly marks as non-mandatory, which is exactly the kind
// of small source-faithful tweak the mandate asks for.
//
// THE ONLY CHANGE: h1Bull removed from goLong.
// REDUNDANCY (E14): bullRegime is the suspected partner covering for this term.
//
// AND IT ATTACKS THIS LAB'S ACTUAL BINDING CONSTRAINT. The 30-trade RATCHET floor is what blocks
// every result here - e58a's 36 is the largest sample the ALCM family has ever produced. If the term
// is redundant, dropping it raises the sample AND simplifies the build at no cost. That is worth more
// to this lab than another tenth of a profit factor.
//
// PARENT: e58a (PF 1.24015239 / DD 9.82519609% / 36 trades), confirmed reproducible E58=E59.
// Shield $1,000, cap 6480, velK 0.8 and every other term held EXACTLY.
//
// AUDIT: LONG ONLY (LESSON 6) - and the short is not merely omitted here, it is currently untestable.
// Stop is risk-defined by the shield, the DECLARED deviation the spec requires (LESSON 5); R = $1,000
// is ~1.0% at BTC $100k, above the 0.8% floor (LESSON 3) but BELOW it above ~$125k - a live tension,
// not a formality. BINDING (E17) is the whole point of the run. LATCH IN SEQUENCE (LESSON 8)
// unchanged from e58a. OCCUPANCY (LESSONS 24/28/29): removing an entry filter admits MORE trades,
// which changes the book and shifts every downstream admission - so this is NOT a controlled subset
// of e58a's 36 trades. NAMED IN ADVANCE, and it is why the trade COUNT is read as the binding
// evidence rather than PF alone.
//
// OUTCOMES REGISTERED BEFORE THE RUN (LESSON 17):
//   * COUNT BARELY MOVES (~36-40) -> the term is INERT. Removing it is a free simplification and the
//     simpler build is preferred at equal PF (fewer terms, less surface to curve-fit).
//   * COUNT RISES AND PF HOLDS OR IMPROVES -> the best available outcome for this lab: more sample
//     AND the same edge, directly easing the 30-trade constraint. KEEP under RATCHET v2.
//   * COUNT RISES AND PF COLLAPSES -> the term BINDS and earns its place.
//   * Fewer than 30 trades -> below RATCHET v2 clause 3 and not quotable as a ratio (LESSON 12).
strategy("War Formation E69a no-h1Bull binding test", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(1000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(6480,  "Max bars in trade -- scaled linearly from E47's 12960 at $2,000")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o

var float c15l = na
var float p15l = na

if new15
    p15l := c15l
    c15l := low
else
    c15l := na(c15l) ? low : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p15l) and not na(velMin) and ta.crossover(close, p15l) and (close - p15l) >= velMin

goLong  = bullRegime and timeGate and brokeBelow and not inMiddle and not longBan and longTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

longR = shieldUsd

if flat and goLong and longR > 0
    strategy.entry("L", strategy.long)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong ? 1 : 0, title="LongSignal")
