//@version=6
// WAR FORMATION E60a — FINER maxBars GRID AROUND e50b's 12960, LOWER SIDE (10800).
//
// Byte-identical to pine/e50b-alcm-long-only-uncoiled.pine except maxBars: 12960 -> 10800.
// E56 ran the coarse neighbourhood (8640 / 25920) around 12960 and found a real but SHALLOW local
// optimum -- PF 1.04 (8640) / 1.22 (12960) / 1.08 (25920), all non-degenerate trade counts (19-22).
// That grid is wide (12960 is ~1.5x from 8640, ~2x from 25920); this pair tightens it to +/-1440
// (~11%) either side to see whether the optimum is a broad plateau or narrows quickly close in.
//
// PRE-REGISTERED OUTCOME (HARD LESSON 17), against e50b's PF 1.21869905 / 21 trades, run together
// with its sibling e60b (maxBars=14400), per HARD LESSON 16 (test both sides of a load-bearing
// parameter) and HARD LESSON 19 (distinguish a real neighbour from a degenerate one):
//   - Both land close to 1.22 with trade counts near 21 -> the plateau is broad and tight around
//     12960, consistent with E56's shallow-optimum finding scaling down to a finer grid.
//   - One or both land closer to E56's coarse-grid values (1.04 / 1.08) or between them and 1.22 ->
//     the optimum narrows faster than the coarse grid suggested; 12960 is a sharper peak than E56
//     read it as.
//   - Trade count collapsing toward single digits on either side -> HARD LESSON 19 degenerate
//     neighbour, report as a count, not a result.
//
// THE SPECIFICATION: War Formation has NO STOP LOSS. The exit is the A.L.C.M. shield -- a fixed dollar
// gap to liquidation. The position ends at target or at liquidation. NEVER add to a losing trade.
//
// PRE-RUN AUDIT:
//   LONG (only leg) -- R = shieldUsd = $2,000, ~2% of BTC price: PASSES the 0.8% floor (HARD LESSON 3).
//     Stop is RISK-DEFINED, not structural -- the declared ALCM deviation from HARD LESSON 5. SL/TP
//     fixed at entry, no trailing.
//   SHORT -- DELETED (identical to e50a/e50b/e56a/e56b/e58a/e58b): no short entry can fire;
//     position_size can never be negative (HARD LESSON 6, trivially satisfied).
//   Redundancy (HARD LESSON 18): none introduced, unchanged from e50b.
//
// SAMPLE CEILING: ~3 days per trade across 4.5 months of 1m data (2025-12-16 to 2026-05-03) caps this
// family near 20-30 trades. A ratio below ~20 trades is reported as a COUNT, not read as a result.
strategy("War Formation E60a e50b maxbars10800", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(2000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(10800, "Max bars in trade -- E60a finer grid, -1440 from e50b's 12960")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o

var float c15l = na
var float p15l = na

if new15
    p15l := c15l
    c15l := low
else
    c15l := na(c15l) ? low : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p15l) and not na(velMin) and ta.crossover(close, p15l) and (close - p15l) >= velMin

goLong  = bullRegime and timeGate and h1Bull and brokeBelow and not inMiddle and not longBan and longTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

longR = shieldUsd

if flat and goLong and longR > 0
    strategy.entry("L", strategy.long)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong ? 1 : 0, title="LongSignal")
