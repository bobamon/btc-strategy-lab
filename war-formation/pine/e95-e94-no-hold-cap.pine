//@version=6
// War Formation E95 -- E94 with the hold cap removed. Parent: E94 (long-only, full 6-year archive).
// BINDING (LESSON 17): the ONLY change from e94-e93-long-only.pine is deletion of the maxBars
// timeout block. maxBars=288 was a LAB ADDITION, not the Oracle's rule -- the ALCM specifies the
// position ends at target or at liquidation and names no time limit.
strategy("War Formation E95 15m long-only NO HOLD CAP", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
greenBear = input.int(2,     "Green 1h candles at or below for BEAR")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
coilK     = input.float(0.85,"Coil: atrFast < atrSlow * K")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atrSlow")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(2000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(288,   "Max bars in trade -- RETAINED AS A DIAGNOSTIC ONLY, NOT ENFORCED")

MS6H = 21600000
MS1H = 3600000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull
bearRegime  = regimeReady and grnPrev <= greenBear

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o
h1Bear = not na(h1o) and close < h1o

// STRUCTURE TIER, RE-DERIVED: was the 15m bucket (c15h/c15l vs p15h/p15l), degenerate at 15m
// native. Now the 1h bucket, tracked the same way, 4 bars/bucket at this resolution -- the
// finest tier that still gives a stable multi-bar reference.
var float c1hh = na
var float c1hl = na
var float p1hh = na
var float p1hl = na

if new1h
    p1hh := c1hh
    p1hl := c1hl
    c1hh := high
    c1hl := low
else
    c1hh := na(c1hh) ? high : math.max(c1hh, high)
    c1hl := na(c1hl) ? low  : math.min(c1hl, low)

brokeBelow = not na(p1hl) and c1hl < p1hl
brokeAbove = not na(p1hh) and c1hh > p1hh

atrFast = ta.atr(1)
atrSlow = ta.atr(2)
coiled  = not na(atrSlow) and atrSlow > 0 and atrFast < atrSlow * coilK
coilPrev = coiled[1]
velMin   = na(atrSlow) ? na : atrSlow * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p1hl) and not na(velMin) and ta.crossover(close, p1hl)  and (close - p1hl) >= velMin
shortTrig = not na(p1hh) and not na(velMin) and ta.crossunder(close, p1hh) and (p1hh - close) >= velMin

goLong  = bullRegime and timeGate and h1Bull and brokeBelow and coilPrev and not inMiddle and not longBan and longTrig
goShort = bearRegime and timeGate and h1Bear and brokeAbove and coilPrev and not inMiddle and shortTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

if flat and goLong
    strategy.entry("L", strategy.long)
    slPx   := close - shieldUsd
    tpPx   := close + shieldUsd * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

// E95: THE HOLD CAP IS REMOVED. This is the ONLY change from e94-e93-long-only.pine.
// The ALCM specifies the position ends at target or at liquidation and names no time limit.
// barsIn is still counted and plotted so hold length stays visible as a diagnostic.

plot(goLong  ? 1 : 0, title="LongSignal")
plot(goShort ? 1 : 0, title="ShortSignal")
plot(barsIn, title="BarsInTrade (cap removed; 288 shown for reference only)", display=display.data_window)
