//@version=6
// WAR FORMATION E58b — SHIELD SWEPT DOWN, SIBLING OF E58a. Read the full rationale in
// e58a-shield1000-maxbars6480.pine's header; this file changes only shieldUsd and maxBars.
//
// shieldUsd = $1,500 (~1.5% of BTC price, clears the 0.8% floor, HARD LESSON 3).
// maxBars scaled linearly from e50b's anchor: 12960 * (1500/2000) = 9720.
// Run together with e58a in the same cycle so HARD LESSON 16/19 (both neighbours of a swept parameter,
// distinguishing a real reading from degeneracy) are actually satisfied, per this lab's own standing
// rule for parameter sweeps.
//
// THE SPECIFICATION: War Formation has NO STOP LOSS. The exit is the A.L.C.M. shield -- a fixed dollar
// gap to liquidation. The position ends at target or at liquidation. NEVER add to a losing trade.
//
// PRE-RUN AUDIT: LONG (only leg) -- R = shieldUsd = $1,500, ~1.5% of BTC price: PASSES the 0.8% floor
//   (HARD LESSON 3). Stop is RISK-DEFINED, not structural -- the declared ALCM deviation from HARD
//   LESSON 5. SL/TP fixed at entry, no trailing. SHORT -- DELETED (identical to e50a/e50b/e58a); no
//   short entry can fire; position_size can never be negative (HARD LESSON 6). Redundancy (HARD LESSON
//   18): none introduced; byte-identical to e50b except shieldUsd and maxBars.
//
// PRE-REGISTERED OUTCOME: identical framing to e58a, read jointly against e50b's PF 1.21869905 / 21
// trades / avgBarsWinning 56.5% at $2,000/12960, and against e58a's own result, before either number is
// interpreted (HARD LESSON 17).
//
// SAMPLE CEILING: ~3 days per trade across 4.5 months of 1m data (2025-12-16 to 2026-05-03) caps this
// family near 20-30 trades under the anchor's own hold-time profile. A ratio below ~20 trades is
// reported as a COUNT, not read as a result.
strategy("War Formation E58b shield1500 cap9720", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(1500,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(9720,  "Max bars in trade -- scaled linearly from E47's 12960 at $2,000")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o

var float c15l = na
var float p15l = na

if new15
    p15l := c15l
    c15l := low
else
    c15l := na(c15l) ? low : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p15l) and not na(velMin) and ta.crossover(close, p15l) and (close - p15l) >= velMin

goLong  = bullRegime and timeGate and h1Bull and brokeBelow and not inMiddle and not longBan and longTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

longR = shieldUsd

if flat and goLong and longR > 0
    strategy.entry("L", strategy.long)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong ? 1 : 0, title="LongSignal")
