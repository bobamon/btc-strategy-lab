//@version=6
// WAR FORMATION E71 - THE SHORT LEG AT 25% OF EQUITY. THE FIRST HONEST TEST OF THE SHORT.
// E64a BYTE-IDENTICAL except the DECLARED DEVIATION below. Serves the user directive of 2026-09-03
// that War Formation must work in both directions, using the source LITERAL 6h rule.
// WHY: HARD LESSON 42. At 100% equity the engine margin call fires long before the shield does --
// E64a winners exited at exactly 2000.0 points while its losers exited at 0.013%-0.585% adverse.
// DECLARED DEVIATION: position size 25% of equity via explicit Pine qty, because the parity profile
// overrides default_qty_value. NOT COMPARABLE to any 100%-equity long, including e58a.
// VERIFY THE SHIELD BOUND with get_trades before interpreting anything (free).
// AUDIT: shield 1000 is 1.2-1.6% of price across this window so LESSON 3 holds; risk-defined stop is
// the declared deviation the ALCM spec requires (LESSON 5); short leg alone, mirroring the users own
// source (LESSON 6 as scoped by HARD LESSON 31); size cannot alter which bars signal (E17); no term
// added or removed (E14); o6/h1o/p15h update on their own boundary before the trigger (LESSON 8);
// OCCUPANCY NAMED IN ADVANCE -- the shield rather than a margin call now ends trades so holds lengthen
// and pyramiding=1 blocks entries, so a count drop from 43 is occupancy NOT selectivity (LESSONS
// 24/28/29). SL and TP FIXED AT ENTRY. No trailing, no averaging down, no martingale.
strategy("War Formation E64a 6h-direction SHORT", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

run6      = input.int(2,     "Consecutive 6h candles for CLEAR DIRECTION (source: more than one)")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min rejection as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
shieldUsd = input.float(1000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
eqFrac    = input.float(0.25,"DECLARED DEVIATION: fraction of equity per position -- HARD LESSON 42")
maxBars   = input.int(6480,  "Max bars in trade -- held at e58a value")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float o6   = na
var int   grn6 = 0
var int   red6 = 0

if new6
    if not na(o6)
        if close[1] > o6
            grn6 := grn6 + 1
            red6 := 0
        else if close[1] < o6
            red6 := red6 + 1
            grn6 := 0
    o6 := open

bearRegime = red6 >= run6

var float h1o = na
if new1h
    h1o := open

h1Bear = not na(h1o) and close < h1o

minsIn   = (time - b6 * MS6H) / 60000
timeGate = minsIn >= skipOpen and minsIn <= (360 - skipClose)

var float c15h = na
var float p15h = na

if new15
    p15h := c15h
    c15h := high
else
    c15h := na(c15h) ? high : math.max(c15h, high)

brokeAbove = not na(p15h) and c15h > p15h

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

shortTrig = not na(p15h) and not na(velMin) and ta.crossunder(close, p15h) and (p15h - close) >= velMin

goShort = bearRegime and timeGate and h1Bear and brokeAbove and not inMiddle and shortTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

shortR = shieldUsd
qtyUse = strategy.equity * eqFrac / close

if flat and goShort and shortR > 0 and qtyUse > 0
    strategy.entry("S", strategy.short, qty = qtyUse)
    slPx   := close + shortR
    tpPx   := close - shortR * rr
    barsIn := 0

if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goShort ? 1 : 0, title="ShortSignal")
plot(red6,            title="ConsecRed6h")
