//@version=6
// WAR FORMATION E57a — SHIELD SWEEP, SCALED CAP: $3,000 SHIELD PAIRED WITH maxBars SCALED BY E48's
// OWN RATIO, NOT HELD FIXED AT 12960.
//
// E48 tried to sweep the shield at a FIXED cap (12960) and found the sweep confounded: at $2,000 the
// cap bound at avgBarsWinning 56% (7317/12960, E47), but at $3,000 on the SAME cap it bound at 84%
// (10900/12960) -- a wider shield needs longer to resolve and the fixed cap was truncating it, so E48's
// PF 0.766 measured a nine-day hold, not the $3,000 A.L.C.M. ("THE SHIELD AND THE CAP ARE COUPLED. THE
// SWEEP CANNOT BE DONE AT A FIXED CAP.").
//
// THIS FILE scales maxBars with shieldUsd by the same ratio the shield itself grew, using E47's own
// numbers as the calibration: 7317 avgBarsWinning / 12960 cap = 56.5% at R=$2,000. Projecting linearly
// with R (untested assumption, stated up front): at R=$3,000 (1.5x), expected avgBarsWinning is
// ~7317*1.5 = 10976. E48's actual measurement at fixed cap 12960 was 10900 -- within 0.7% of that
// linear projection, which is the empirical basis for scaling maxBars linearly with shieldUsd here
// rather than picking an arbitrary wider cap. maxBars = 12960 * 1.5 = 19440 restores the SAME ~56%
// avgBarsWinning ratio e50b/E47 ran at, so this run and e50b are compared at matched cap-bind pressure,
// not matched absolute bar count.
//
// THE SPECIFICATION: War Formation has NO STOP LOSS. The exit is the A.L.C.M. shield -- a fixed dollar
// gap to liquidation. The position ends at target or at liquidation. NEVER add to a losing trade.
//
// PRE-RUN AUDIT (HARD LESSON 6, one line per leg):
//   LONG (only leg) -- R = shieldUsd = $3,000, ~3.3% of BTC price near $90k: PASSES the 0.8% floor
//     (HARD LESSON 3) with more room than e50b's $2,000. Stop is RISK-DEFINED, not structural -- the
//     declared ALCM deviation (HARD LESSON 5). SL/TP fixed at entry, no trailing. Same latch order as
//     e50b: 15m level breaks (brokeBelow), then 1m reclaim (HARD LESSON 8). coilPrev stays removed
//     (HARD LESSON 18 -- unused terms deleted, not left dead).
//   SHORT -- DELETED, identical to e50b/e56a/e56b: no short entry can fire; position_size can never go
//     negative. Fourteen mirrored-short constructions have failed in this lab (HARD LESSON, standing);
//     this file does not attempt a fifteenth.
//   Redundancy (HARD LESSON 18): identical to e50b otherwise -- only shieldUsd and maxBars change from
//     that anchor. No new terms introduced, so no new redundancy to check.
//
// PRE-REGISTERED OUTCOME (HARD LESSON 17), against e50b's PF 1.21869905 / 21 trades / avgBarsWinning
// 56% at $2,000:
//   - PF close to 1.22 (say within ~15-20%), trade count not collapsed (>~15), and avgBarsWinning ratio
//     lands near the targeted ~55-60% (confirming the linear scaling held) -> shield width is not the
//     binding lever in this range; e50b's $2,000/12960 pairing remains the reasonable working point.
//   - PF meaningfully BETTER with adequate trade count -> a wider shield genuinely helps once decoupled
//     from the cap (larger R = fewer noise-driven stopouts), worth pursuing further up toward $4,000.
//   - PF meaningfully WORSE, especially if avgBarsWinning ratio still comes in far above ~60% despite
//     the scaled cap -> the linear-scaling projection itself does not hold; hold time grows faster than
//     proportionally with R, and this construction cannot cleanly decouple shield from cap within a
//     reasonable maxBars.
//   - Trade count collapsing toward single digits -> HARD LESSON 19 degenerate neighbour, report as a
//     count, not a result.
//
// SAMPLE CEILING: ~3 days per trade across 4.5 months of 1m data (2025-12-16 to 2026-05-03) caps this
// family near 20-30 trades. A ratio below ~20 trades is reported as a COUNT, not read as a result.
strategy("War Formation E57a shield3000 maxbars19440", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(3000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(19440, "Max bars in trade -- scaled 1.5x from E47's 12960 for 1.5x shield")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o

var float c15l = na
var float p15l = na

if new15
    p15l := c15l
    c15l := low
else
    c15l := na(c15l) ? low : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p15l) and not na(velMin) and ta.crossover(close, p15l) and (close - p15l) >= velMin

goLong  = bullRegime and timeGate and h1Bull and brokeBelow and not inMiddle and not longBan and longTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

longR = shieldUsd

if flat and goLong and longR > 0
    strategy.entry("L", strategy.long)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong ? 1 : 0, title="LongSignal")
