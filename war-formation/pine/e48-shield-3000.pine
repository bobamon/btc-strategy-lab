//@version=6
// WAR FORMATION E48 - SHIELD $3,000 UNDER THE CORRECTED CAP. REVERTED, AND INCONCLUSIVE.
//   https://mcp-api.trader.dev/backtest/01M1JBHB9VPEFCTFW7NE5RKEJA
//   PF 0.76633130 | DD 28.92342722% | 15 trades | 40.00% win | -7.52% | long-only
//
//   E47 ($2,000): PF 1.21869905 | DD 17.44898097% | 21 trades | avgBarsWinning 7317/12960 = 56%
//   E48 ($3,000): PF 0.76633130 | DD 28.92342722% | 15 trades | avgBarsWinning 10900/12960 = 84%
//
// REVERTED on the ratchet - worse on both terms. But it does NOT settle the shield question, for two
// reasons stated before and after the run:
//
//   1. **15 trades is below the ~20 floor** registered in advance. The COUNT is reported; 0.766 is
//      NOT read as a profit factor. The revert rests on "did not improve", not on that number.
//   2. **THE CAP BINDS AGAIN AT $3,000 - 84% of the maximum hold.** E47 proved 12960 was long enough
//      for a $2,000 shield (56%). A wider shield needs longer to resolve, so E48 measures a NINE-DAY
//      HOLD, not the $3,000 A.L.C.M. That is precisely the failure E47 fixed, re-appearing one
//      shield-width up.
//
// **THE SHIELD AND THE CAP ARE COUPLED AND CANNOT BE SWEPT INDEPENDENTLY.** Any shield comparison at
// a fixed cap is confounded, because the wider shield is the one the cap truncates.
//
// SO E38-E41's $2,000 CONCLUSION IS NEITHER CONFIRMED NOR REFUTED. And it now carries THREE known
// confounds rather than two: unreproducible code (E44), a binding cap (E47, and this run shows it
// bound differently at each width), and risk-per-trade varying with shield width - with
// percent_of_equity = 100, a $2,000 shield risks 2% of equity per trade and $3,000 risks 3%.
//
// TO COMPARE SHIELD WIDTHS HONESTLY, the cap must be raised until avgBarsWinning stops pinning AT
// EACH WIDTH separately, then the widths compared. That is the queue item this run produced.
//
// AUDIT: LONG ONLY - no short leg since E45/E46, nothing mirrored (LESSON 6). R = $3,000, ~3% of
// price, clears the 0.8% floor (LESSON 3). Stop RISK-DEFINED not structural - the DECLARED deviation
// the ALCM requires (LESSON 5). SL and TP fixed at entry. Latch order intact: 15m level breaks, then
// the 1m reclaim (HARD LESSON 8). BINDING (E17): the shield width was the term under test - and the
// CAP turned out to bind instead, which is the finding.
strategy("War Formation E48 shield 3000", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
greenBear = input.int(2,     "Green 1h candles at or below for BEAR")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
coilK     = input.float(0.85,"3m coil: atr(3) < atr(30) * K")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(3000,"THE SHIELD -- THE ONE CHANGE, was 2000")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(12960, "Max bars in trade -- NINE DAYS. E47: the cap was binding at 4320")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull
bearRegime  = regimeReady and grnPrev <= greenBear

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o
h1Bear = not na(h1o) and close < h1o

var float c15h = na
var float c15l = na
var float p15h = na
var float p15l = na

if new15
    p15h := c15h
    p15l := c15l
    c15h := high
    c15l := low
else
    c15h := na(c15h) ? high : math.max(c15h, high)
    c15l := na(c15l) ? low  : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l
brokeAbove = not na(p15h) and c15h > p15h

atrFast = ta.atr(3)
atrSlow = ta.atr(30)
coiled  = not na(atrSlow) and atrSlow > 0 and atrFast < atrSlow * coilK
coilPrev = coiled[1]
velMin   = na(atrSlow) ? na : atrSlow * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p15l) and not na(velMin) and ta.crossover(close, p15l)  and (close - p15l) >= velMin
shortTrig = not na(p15h) and not na(velMin) and ta.crossunder(close, p15h) and (p15h - close) >= velMin

goLong  = bullRegime and timeGate and h1Bull and brokeBelow and coilPrev and not inMiddle and not longBan and longTrig
goShort = bearRegime and timeGate and h1Bear and brokeAbove and coilPrev and not inMiddle and shortTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

longR  = shieldUsd
shortR = shieldUsd

if flat and goLong and longR > 0
    strategy.entry("L", strategy.long)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0

if flat and goShort and shortR > 0
    strategy.entry("S", strategy.short)
    slPx   := close + shortR
    tpPx   := close - shortR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong  ? 1 : 0, title="LongSignal")
plot(goShort ? 1 : 0, title="ShortSignal")
