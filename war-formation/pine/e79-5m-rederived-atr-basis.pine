//@version=6
// WAR FORMATION E79 -- E78 ON 5m, ATR BASIS RE-DERIVED TO GENUINE CLOCK TIME.
//
// E78 ported the ALCM cascade to 5m and carried atr(3)/atr(30) over UNCHANGED from the
// 1m build -- a DECLARED DEVIATION E78 itself flagged: on 5m bars that reads 15min/150min
// of real time, not the 1m build's intended 3min/30min. Per HARD LESSON 40 (geometry in
// bars does not transfer across timeframes) this needs a re-derivation, not a rescale.
//
// THE CORRECTION: atrSlow -> atr(6) (6 * 5m = 30 minutes, an EXACT match to the 1m
// build's atr(30) -- this also fixes velMin, the velocity floor, which reads atrSlow
// alone). atrFast -> atr(1) (5 minutes, the closest achievable proxy for 3 minutes at
// this bar resolution; sub-bar windows do not exist). Nothing else changed from E78:
// same shieldUsd ($2,000), rr (2.0), maxBars (864), cascade, gates, both directions.
// This answers E78's own queue item 1 as a single-variable isolation (HARD LESSON 16/E17).
//
// RESULT (BTCUSDT, 5m, 2024-06-08 to 2026-09-01, 234,663 bars):
//   PF 0.86373954 (E78: 0.78597499) | trades 114 (E78: 115) | win rate 21.92982456%
//   (E78: 21.73913043%) | net -11.62327653% (E78: -18.26452824%) | max DD 21.07275805%
//   (E78: 30.19142159%) | long 51 trades/21 wins (E78: 50/21) | short 63 trades/4 wins
//   (E78: 65/4) | commission $1,116.45
//
// VERDICT: the atr-deviation confound is RULED OUT as the cause of E78's failure. The
// corrected basis reproduced E78's population almost exactly -- identical long-winner
// count (21), identical short-winner count (4), near-identical trade count and win rate
// -- rather than reshuffling which trades fire. PF and drawdown both improved somewhat,
// but PF stays below 1.0 on a sample well clear of the 30-trade floor. KILL RULE APPLIES:
// DISCARDED. The short leg is confirmed dead again on its largest-ever sample: 4/63
// (6.3%), matching E78's 4/65 (6.2%) almost exactly across two independent atr bases.
//
// NOT a candidate, NOT a KEEP. Reference builds unchanged: e58a (long, 1m, 100% equity)
// and E71 (short, 1m, 25% equity, declared deviation). This run exists to close a queue
// item, not to propose a change.
strategy("War Formation E79 5m re-derived atr basis", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
greenBear = input.int(2,     "Green 1h candles at or below for BEAR")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
coilK     = input.float(0.85,"Coil: atrFast < atrSlow * K")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atrSlow")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(2000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(864,   "Max bars in trade -- three days of 5m")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull
bearRegime  = regimeReady and grnPrev <= greenBear

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o
h1Bear = not na(h1o) and close < h1o

var float c15h = na
var float c15l = na
var float p15h = na
var float p15l = na

if new15
    p15h := c15h
    p15l := c15l
    c15h := high
    c15l := low
else
    c15h := na(c15h) ? high : math.max(c15h, high)
    c15l := na(c15l) ? low  : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l
brokeAbove = not na(p15h) and c15h > p15h

atrFast = ta.atr(1)
atrSlow = ta.atr(6)
coiled  = not na(atrSlow) and atrSlow > 0 and atrFast < atrSlow * coilK
coilPrev = coiled[1]
velMin   = na(atrSlow) ? na : atrSlow * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p15l) and not na(velMin) and ta.crossover(close, p15l)  and (close - p15l) >= velMin
shortTrig = not na(p15h) and not na(velMin) and ta.crossunder(close, p15h) and (p15h - close) >= velMin

goLong  = bullRegime and timeGate and h1Bull and brokeBelow and coilPrev and not inMiddle and not longBan and longTrig
goShort = bearRegime and timeGate and h1Bear and brokeAbove and coilPrev and not inMiddle and shortTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

if flat and goLong
    strategy.entry("L", strategy.long)
    slPx   := close - shieldUsd
    tpPx   := close + shieldUsd * rr
    barsIn := 0

if flat and goShort
    strategy.entry("S", strategy.short)
    slPx   := close + shieldUsd
    tpPx   := close - shieldUsd * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong  ? 1 : 0, title="LongSignal")
plot(goShort ? 1 : 0, title="ShortSignal")
