//@version=6
// WAR FORMATION E77 - THE LONG WITHOUT THE WHOLE-NUMBER BAND, AT 25% EQUITY.
// THE LAST CELL IN THE 2x2 THIS LAB HAS BEEN BUILDING SINCE E71: {band on/off} x {100%/25% equity}.
//
// WHY THIS AND NOT A NEW GEOMETRY. E76 closed the short-leg entry-term binding sweep; every entry term
// on both legs is now measured (E69/E70 long, E74/E75/E76 short). The one item BOTH E74's and E75/E76's
// own queues carried forward unresolved is this: E69b measured "no band" at 100% equity (PF 1.22985003,
// DD 9.28%, 43 trades) and E74 measured "no band" on the SHORT at 25% equity (PF 1.16714444, DD 3.61%,
// 41 trades) -- but nobody has run the LONG's "no band" build at the SAME 25% equity E74 used, so the
// two are not actually comparable side by side. This is that run. Two ALREADY-VALIDATED changes
// (E69b's band removal, E72's equity-fraction control) combined into their one untested cell, not a new
// mechanism.
//
// REGISTERED PREDICTION, BEFORE RUNNING: E72 already showed a LONG is insensitive to the 100%->25%
// equity change with the band PRESENT -- identical 36-trade population, identical win/loss split,
// drawdown scaling down mechanically (9.83%->2.51%), PF moving +0.022. If that insensitivity holds
// independent of the band term, this run should reproduce E69b's exact 43-trade population and win/loss
// split, with drawdown scaled down by roughly the same ~3.9x factor E72 showed (predicting ~2.4%) and PF
// close to E69b's 1.22985003. A DIFFERENT population or win/loss split than E69b's 43 would mean the
// equity-insensitivity finding does not generalise past the build E72 tested it on -- a genuinely new
// result, not a re-confirmation.
//
// AUDIT (per HARD LESSON 6, one line per lesson):
// - LESSON 3 (R >= 0.8%): shield $1,000 is ~1.0-1.6% of price over this window -- unchanged from e58a
//   /e69b, and the live tension above ~$125k BTC is the same pre-existing caveat, not new here.
// - LESSON 5 (risk-defined stop): unchanged -- the shield fixes slPx/tpPx exactly as in e58a/e69b/e72.
//   eqFrac 0.25 is the DECLARED DEVIATION the ALCM spec requires (same one E71/E72 already used).
// - LESSON 6 (every leg audited): LONG ONLY. The short is not touched by this file.
// - E17 (binding): the whole-number band is the ONLY term changed from e72; nothing else added/removed.
// - E14 (redundancy): no new term introduced -- this is e69b's already-tested removal plus e72's
//   already-tested sizing change, combined for the first time.
// - LESSON 8 (latch in sequence): h1o/p15l/c15l update on their own boundaries before the trigger,
//   byte-identical to e58a/e69b/e72.
// - OCCUPANCY (LESSONS 24/28/29), NAMED IN ADVANCE: removing the band admits MORE trades (E69b: 36->43
//   at 100% equity). E72 showed equity fraction does NOT change occupancy/admission for the long. So the
//   predicted count here is ~43, matching E69b, not e72's 36. A materially different count would be the
//   finding, not a nuisance to explain away.
// SL and TP FIXED AT ENTRY. No trailing, no averaging down, no martingale, no stop loss beyond the ALCM
// shield (ORACLE-RULES.md: this strategy has NO stop loss in the traditional sense -- exit is shield or
// target only).
strategy("War Formation E77 long no-band 25pct equity", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atr(30)")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(1000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
eqFrac    = input.float(0.25,"DECLARED DEVIATION: fraction of equity -- matches E71/E72/E74 so the legs compare")
maxBars   = input.int(6480,  "Max bars in trade -- scaled linearly from E47's 12960 at $2,000")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o

var float c15l = na
var float p15l = na

if new15
    p15l := c15l
    c15l := low
else
    c15l := na(c15l) ? low : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p15l) and not na(velMin) and ta.crossover(close, p15l) and (close - p15l) >= velMin

// THE ONLY CHANGE FROM e72: the inMiddle (whole-number band) ban is removed from goLong, per e69b.
goLong  = bullRegime and timeGate and h1Bull and brokeBelow and not longBan and longTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

longR  = shieldUsd
qtyUse = strategy.equity * eqFrac / close

if flat and goLong and longR > 0 and qtyUse > 0
    strategy.entry("L", strategy.long, qty = qtyUse)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong ? 1 : 0, title="LongSignal")
