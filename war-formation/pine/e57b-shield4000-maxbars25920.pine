//@version=6
// WAR FORMATION E57b — SHIELD SWEEP, SCALED CAP: $4,000 SHIELD (ORACLE-RULES: "$4,000 is safer")
// PAIRED WITH maxBars SCALED BY THE SAME RATIO AS E57a, NOT HELD FIXED AT 12960.
//
// Sibling of E57a. Same calibration basis (E47's 7317/12960 = 56.5% avgBarsWinning at R=$2,000,
// confirmed as an approximately linear projection by E48's actual 10900/12960 = 84% at R=$3,000 vs the
// ~10976 predicted). At R=$4,000 (2x e50b's $2,000), maxBars = 12960 * 2 = 25920 restores the same
// ~56% avgBarsWinning ratio. NOTE: this lab already has a $2,000-shield run AT maxBars=25920 (E56b, PF
// 1.07927810, 19 trades, cap never binds) -- that is NOT reusable here, since this file pairs the same
// cap with double the shield width (R), a different exit geometry entirely.
//
// THE SPECIFICATION: War Formation has NO STOP LOSS. The exit is the A.L.C.M. shield -- a fixed dollar
// gap to liquidation. The position ends at target or at liquidation. NEVER add to a losing trade.
//
// PRE-RUN AUDIT (HARD LESSON 6, one line per leg):
//   LONG (only leg) -- R = shieldUsd = $4,000, ~4.4% of BTC price near $90k: PASSES the 0.8% floor
//     (HARD LESSON 3) with the most room of the three shield widths tested this cycle. Stop is
//     RISK-DEFINED, not structural -- the declared ALCM deviation (HARD LESSON 5). SL/TP fixed at
//     entry, no trailing. Same latch order as e50b: 15m level breaks (brokeBelow), then 1m reclaim
//     (HARD LESSON 8). coilPrev stays removed (HARD LESSON 18).
//   SHORT -- DELETED, identical to e50b/e56a/e56b/e57a: no short entry can fire; position_size can
//     never go negative. Fourteen mirrored-short constructions have failed in this lab; this file does
//     not attempt a fifteenth.
//   Redundancy (HARD LESSON 18): identical to e50b/e57a otherwise -- only shieldUsd and maxBars change.
//     No new terms introduced, so no new redundancy to check.
//
// PRE-REGISTERED OUTCOME (HARD LESSON 17), against e50b's $2,000 anchor (PF 1.21869905, 21 trades) AND
// against E57a's $3,000 reading, run together in this same cycle:
//   - PF continues in the same range as $2,000/$3,000 with adequate trade count -> shield width is not
//     the binding lever across $2k-$4k once decoupled from the cap; the ALCM's edge (if any) is
//     insensitive to shield width in this range, and $2,000 remains the reasonable working point (it
//     also risks the least equity per trade).
//   - PF rises monotonically with shield width ($2k -> $3k -> $4k) with adequate trade counts -> wider
//     shields genuinely help once the cap is no longer confounding the comparison; the ORACLE-RULES
//     note that "$4,000 is safer" would be supported empirically, not just by the source material.
//   - PF falls or is non-monotonic -> no clean shield-width effect in this range; report the shape
//     plainly rather than picking whichever point looks best.
//   - Trade count collapsing toward single digits, or avgBarsWinning ratio far above ~60% despite the
//     scaled cap -> HARD LESSON 19 degenerate neighbour / scaling projection failure, report as a count
//     or a caveat, not a clean result.
//
// SAMPLE CEILING: ~3 days per trade across 4.5 months of 1m data (2025-12-16 to 2026-05-03) caps this
// family near 20-30 trades. A ratio below ~20 trades is reported as a COUNT, not read as a result.
strategy("War Formation E57b shield4000 maxbars25920", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(4000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
maxBars   = input.int(25920, "Max bars in trade -- scaled 2x from E47's 12960 for 2x shield")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o

var float c15l = na
var float p15l = na

if new15
    p15l := c15l
    c15l := low
else
    c15l := na(c15l) ? low : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p15l) and not na(velMin) and ta.crossover(close, p15l) and (close - p15l) >= velMin

goLong  = bullRegime and timeGate and h1Bull and brokeBelow and not inMiddle and not longBan and longTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

longR = shieldUsd

if flat and goLong and longR > 0
    strategy.entry("L", strategy.long)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong ? 1 : 0, title="LongSignal")
