//@version=6
// WAR FORMATION E72 - THE LONG LEG AT 25% OF EQUITY. THE COMPARABILITY CONTROL.
// e58a BYTE-IDENTICAL except the same DECLARED DEVIATION as E71, so the two legs can finally be set
// side by side. Comparing E71s 25% short to a 100% long is the error HARD LESSON 43 warns about.
// REGISTERED PREDICTION: a LONG should be INSENSITIVE to the size change, because an adverse move
// SHRINKS the notional so required margin falls alongside equity and the two never cross. Its shield
// already bound at 100%. If instead the long moves materially, every 100%-equity number in this lab
// needs re-running -- which is why this control is worth a credit rather than being assumed.
// AUDIT: shield 1000 is 1.2-1.6% of price over this window so LESSON 3 holds; risk-defined stop is the
// declared deviation the ALCM spec requires (LESSON 5); LONG leg alone (LESSON 6 as scoped); size
// cannot alter which bars signal (E17); no term added or removed (E14); h1o/p15l update on their own
// boundary before the trigger (LESSON 8); OCCUPANCY NAMED IN ADVANCE - if the shield already bound at
// 100% the count should stay near 36, and a large move would mean longs were being cut short too
// (LESSONS 24/28/29). SL and TP FIXED AT ENTRY. No trailing, no averaging down, no martingale.
strategy("War Formation E72 long 25pct equity", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

greenBull = input.int(4,     "Green 1h candles for BULL")
skipOpen  = input.int(60,    "Skip first N minutes of 6h block")
skipClose = input.int(60,    "Skip last N minutes of 6h block")
velK      = input.float(0.8, "Velocity: min reclaim as multiple of atr(30)")
midLo     = input.float(400, "Whole-number middles low")
midHi     = input.float(600, "Whole-number middles high")
etOffset  = input.int(-4,    "ET offset from UTC")
witchOn   = input.bool(true, "Ban longs in witching hour 1-4am ET")
shieldUsd = input.float(1000,"THE SHIELD: fixed dollar gap to liquidation")
rr        = input.float(2.0, "Reward:risk")
eqFrac    = input.float(0.25,"DECLARED DEVIATION: fraction of equity -- matches E71 so the legs compare")
maxBars   = input.int(6480,  "Max bars in trade -- scaled linearly from E47's 12960 at $2,000")

MS6H = 21600000
MS1H = 3600000
MS15 = 900000

b6  = math.floor(time / MS6H)
b1h = math.floor(time / MS1H)
b15 = math.floor(time / MS15)

new6  = b6  != b6[1]
new1h = b1h != b1h[1]
new15 = b15 != b15[1]

var float h1o     = na
var int   grnCur  = 0
var int   cntCur  = 0
var int   grnPrev = 0
var int   cntPrev = 0

if new6
    grnPrev := grnCur
    cntPrev := cntCur
    grnCur  := 0
    cntCur  := 0

if new1h
    if not na(h1o)
        cntCur := cntCur + 1
        if close[1] > h1o
            grnCur := grnCur + 1
    h1o := open

regimeReady = cntPrev >= 5
bullRegime  = regimeReady and grnPrev >= greenBull

minsIn    = (time - b6 * MS6H) / 60000
timeGate  = minsIn >= skipOpen and minsIn <= (360 - skipClose)

h1Bull = not na(h1o) and close > h1o

var float c15l = na
var float p15l = na

if new15
    p15l := c15l
    c15l := low
else
    c15l := na(c15l) ? low : math.min(c15l, low)

brokeBelow = not na(p15l) and c15l < p15l

velMin = na(ta.atr(30)) ? na : ta.atr(30) * velK

sub      = close - math.floor(close / 1000) * 1000
inMiddle = sub >= midLo and sub <= midHi

hUTC     = math.floor(time / MS1H) % 24
hET      = (hUTC + etOffset + 24) % 24
witching = hET >= 1 and hET < 4
longBan  = witchOn and witching

longTrig  = not na(p15l) and not na(velMin) and ta.crossover(close, p15l) and (close - p15l) >= velMin

goLong  = bullRegime and timeGate and h1Bull and brokeBelow and not inMiddle and not longBan and longTrig

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

longR  = shieldUsd
qtyUse = strategy.equity * eqFrac / close

if flat and goLong and longR > 0 and qtyUse > 0
    strategy.entry("L", strategy.long, qty = qtyUse)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(goLong ? 1 : 0, title="LongSignal")
