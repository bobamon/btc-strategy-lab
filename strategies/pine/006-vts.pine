//@version=6
// VTS-1 "Volatility Term-Structure Regime" — BTCUSDT, 15m and 5m.
// Bitcoin shows INVERTED volatility asymmetry: vol reacts more to positive returns than negative
// ones, the opposite of equities. So the two legs are built differently, not mirrored:
//   LONG  = breakout WITH vol expansion   (BTC's real up-moves arrive loud)
//   SHORT = breakdown WITH vol compression (BTC's distribution arrives quiet)
// Flip signal: the term-structure ratio crossing either threshold. On a flip, stand down for
// coolBars bars -- the regime is in transition and neither leg's premise holds.
// SL and TP fixed at entry. Stops sit beyond STRUCTURE (swing extremes), never beyond the trigger.
strategy("VTS-1 Volatility Term-Structure Regime", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

fastLen  = input.int(5,     "Fast ATR (short horizon)")
slowLen  = input.int(50,    "Slow ATR (long horizon)")
hiK      = input.float(1.40,"Expansion if fast/slow >= K")
loK      = input.float(0.75,"Compression if fast/slow <= K")
brkLen   = input.int(50,    "Breakout lookback")
swgLen   = input.int(20,    "Swing lookback for the structural stop")
coolBars = input.int(20,    "Bars to stand down after a regime flip")
bufK     = input.float(0.25,"Stop buffer beyond the swing, x ATR14")
rr       = input.float(2.0, "Reward:risk")
minRpct  = input.float(0.80,"Min risk as % of price")
maxRpct  = input.float(3.00,"Max risk as % of price")
maxBars  = input.int(96,    "Max bars in trade")

atrFast = ta.atr(fastLen)
atrSlow = ta.atr(slowLen)
atrStop = ta.atr(14)

// ---- the term structure ----
vts = (not na(atrSlow) and atrSlow > 0) ? atrFast / atrSlow : na

expansion   = not na(vts) and vts >= hiK
compression = not na(vts) and vts <= loK

// ---- FLIP DETECTION: the regime changing, in either direction ----
regime     = expansion ? 1 : compression ? -1 : 0
flipped    = regime != regime[1] and not na(vts) and not na(vts[1])
var int sinceFlip = 9999
sinceFlip := flipped ? 0 : sinceFlip + 1
coolingOff = sinceFlip < coolBars

// ---- levels ----
brkHi = ta.highest(high, brkLen)[1]
brkLo = ta.lowest(low,  brkLen)[1]
swgHi = ta.highest(high, swgLen)[1]
swgLo = ta.lowest(low,  swgLen)[1]

// ---- LONG leg: the loud breakout. Needs vol EXPANSION. ----
goLong = expansion and not coolingOff and ta.crossover(close, brkHi)

// ---- SHORT leg: the quiet breakdown. Needs vol COMPRESSION. Different premise entirely. ----
goShort = compression and not coolingOff and ta.crossunder(close, brkLo)

// ---- risk: each leg stops beyond its OWN structure, floored so fees stay small vs R ----
buf  = na(atrStop) ? 0.0 : atrStop * bufK
minR = close * minRpct / 100
maxR = close * maxRpct / 100

rawLongR  = close - (swgLo - buf)
rawShortR = (swgHi + buf) - close
longR     = math.min(math.max(rawLongR,  minR), maxR)
shortR    = math.min(math.max(rawShortR, minR), maxR)

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

if flat and goLong and longR > 0
    strategy.entry("L", strategy.long)
    slPx   := close - longR
    tpPx   := close + longR * rr
    barsIn := 0
else if flat and goShort and shortR > 0
    strategy.entry("S", strategy.short)
    slPx   := close + shortR
    tpPx   := close - shortR * rr
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1
if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(vts,                  title="VolTermStructure")
plot(regime,               title="Regime")
plot(flipped ? 1 : 0,      title="FlipEvent")
plot(coolingOff ? 1 : 0,   title="CoolingOff")
