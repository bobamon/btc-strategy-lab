//@version=6
// 3M ELITE v56 - THE SOURCE OWN BIAS RULE, REPLACING THE LAB INVENTED PROXY. LONG LEG.
// v54 gated on "consecutive higher/lower closes on 12H AND 24H" -- this lab own invention. The
// transcripts define bias as a 20/50/200 SMA STACK on the 15m WORKING CHART:
//   [00:28] MAs "help mainly on the 15 MINUTE time frame"   [01:30] "the twenty, the fifty and the two hundred"
//   [04:20] bullish "the 200 on the bottom, then the 50, then the 20"
//   [02:47] "the 200 ... is more indication of the HIGHER TIMEFRAME TREND"  -- he reads HTF trend from
//           the 200 MA on this chart rather than pulling a higher timeframe.
//   [03:01] "the average price of the last 200 candles" -- an SMA, not an EMA.
// AUDIT: R>=0.8% by EXCLUSION, unchanged (LESSON 3); stop at dzBot, the zone low, UNCHANGED (LESSON 5);
// LONG leg alone, the legs are not independent so no bundling (LESSON 6 scoped / v24); the stack gate
// NECESSARILY binds so the COUNT IS READ FIRST (E17); REDUNDANCY IS REAL AND NAMED -- a demand tap
// already tends to occur in uptrends so the gate may overlap what the zone logic selects (E14); SMAs
// read on the entry bar, zone built from a COMPLETED 4H candle (LESSON 8); pyramiding=1 so blocking an
// entry can free a LATER one v37 never saw, hence not a clean subset (LESSONS 24/28/29); expect
// cascadeRatio 1 (LESSON 35). SL and TP FIXED AT ENTRY. No trailing, averaging down or martingale.
// RESULT: falsifier fired. Count 155 -> 37 (76% cut), WORSE than v54. PF 1.62137752 / DD 6.18395066%
// looks excellent but RATCHET v2 clause 4 is UNSATISFIABLE: the split gives H1=27 and H2=10, both under
// the 30-trade floor. DOES NOT PROMOTE. v37 remains champion.
strategy("3M ELITE v56 source MA stack bias LONG", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

rTarget  = input.float(2.0, "Target, x R")
maxBars  = input.int(96,    "Max bars in trade (entry timeframe)")
maxAge   = input.int(6,     "Zone freshness cap, 4H candles since creation -- THE ONE CHANGE (12 -> 6)")
minRpct  = input.float(0.80,"Min stop distance as % of price (LESSON 3)")
maFast   = input.int(20,    "THE SOURCE STACK: fast MA")
maMid    = input.int(50,    "THE SOURCE STACK: middle MA")
maSlow   = input.int(200,   "THE SOURCE STACK: slow MA -- his higher-timeframe read")

// ---------- THE ONE NEW TERM: the 20/50/200 stack on the 15m working chart ----------
sma20  = ta.sma(close, maFast)
sma50  = ta.sma(close, maMid)
sma200 = ta.sma(close, maSlow)
stackBull = not na(sma200) and sma20 > sma50 and sma50 > sma200

MS4H = 14400000
b4h  = math.floor(time / MS4H)
new4h = b4h != b4h[1]

// ---------- reconstruct the 4H candle from 15m bars: in-progress OHLC ----------
var float o4 = na
var float h4 = na
var float l4 = na

// ---------- snapshots of the two most recently COMPLETED 4H candles (open + close; +H/L for the most recent) ----------
var float pO  = na
var float pH  = na
var float pL  = na
var float pC  = na
var float ppO = na
var float ppC = na

if new4h and not na(o4)
    ppO := pO
    ppC := pC
    pO  := o4
    pH  := h4
    pL  := l4
    pC  := close[1]

if new4h
    o4 := open
    h4 := high
    l4 := low
else
    h4 := na(h4) ? high : math.max(h4, high)
    l4 := na(l4) ? low  : math.min(l4, low)

// ---------- engulf on the just-completed candle vs the one before it (body containment, no gap) ----------
bullEngulf = not na(ppO) and not na(ppC) and not na(pO) and not na(pC) and ppC < ppO and pC > pO and pC > ppO
bearEngulf = not na(ppO) and not na(ppC) and not na(pO) and not na(pC) and ppC > ppO and pC < pO and pC < ppO

// ---------- demand zone lifecycle: create on bull engulf, mitigate on a body close inside, age in 4H units ----------
var float dzTop   = na
var float dzBot   = na
var bool  dzLive  = false
var int   dzTouch = 0
var int   dzAge   = 0
var bool  dzTraded = false

if new4h
    if dzLive and not na(pC) and pC <= dzTop
        dzTouch := dzTouch + 1
        if dzTouch >= 2
            dzLive := false
    if dzLive
        dzAge := dzAge + 1
    if bullEngulf
        dzTop   := pO
        dzBot   := pL
        dzLive  := true
        dzTouch := 0
        dzAge   := 0
        dzTraded := false

// ---------- entry: zone live, sequenced after creation, not yet double-mitigated, price back at the zone, still fresh ----------
minR    = close * minRpct / 100
rBig    = not na(dzBot) and (close - dzBot) >= minR

longCond = rBig and dzLive and not dzTraded and dzAge >= 1 and dzTouch < 2 and low <= dzTop and close > dzBot and dzAge <= maxAge and stackBull

flat = strategy.position_size == 0

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

if flat and longCond and not na(dzBot) and close > dzBot
    r = close - dzBot
    if r > 0
        strategy.entry("L", strategy.long)
        dzTraded := true
        slPx   := dzBot
        tpPx   := close + r * rTarget
        barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(dzLive ? 1 : 0, title="DemandZoneLive")
plot(dzAge,          title="DemandZoneAge")
