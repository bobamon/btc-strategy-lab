//@version=6
// 3M ELITE v4 — BTCUSDT, 1m base chart.
// Same cascade as v1/v2/v3: BIAS 12H -> ZONE 3H -> STRUCTURE 48m -> ENTRY 3m.
//
// CHANGE FROM v3 (single experiment this cycle): implements ZONE INVALIDATION, decoded from
// VOCABULARY.md ("the second that we get a candle that body closes below the zone, this entire
// zone is invalid... we just need a new triple M or a new engulfing candle"), judged on the
// ZONE's OWN timeframe (3H here — the source's example is explicit that a 1H zone invalidates on
// a 1H body close, not on the validation timeframe). This is SYSTEM.md queue item 0d, the LAST
// decoded-but-unimplemented VOCABULARY.md gate — automatic top priority per this project's rule
// that a freshly-decoded, unimplemented definition outranks the rest of the queue, regardless of
// how the other two decoded gates (Type 2 validation in v2, protected stop in v3) scored.
//
// v3's await/valid state machine already tracks a zone across multiple bars (armed by a tap,
// resolved by validation or a bias flip), so zone invalidation composes naturally onto it: v1's
// architecture has no persisting zone to invalidate (demandTap/supplyTap are single-bar tests),
// which is why this gate is built on v3, not v1, even though v3 itself was rejected against v1.
// The goal this cycle is to finish the fully-decoded checklist gate stack, not to chase v1's
// numbers — the queue explicitly reserves "isolate the stop from the gate" (0e) for AFTER all
// three decoded gates have been tried together.
//
// New this cycle: at the moment a tap ARMS the wait, the zone's own price bound (the 3H level
// that was tapped) is captured and held fixed as zoneLow/zoneHigh. On every completed 3H candle
// (the zone's own timeframe), if that candle's close breaches the captured bound, the zone is
// invalid — await AND validated state are both cleared, the protected level and zone bound are
// wiped, and a fresh tap + fresh validation are required. Because this check runs on every 3H
// close regardless of await/valid state, it automatically covers the source's "immediate
// re-validation" case (the candle right after a validation itself body-closing beyond the zone).
// Type 1 (3M/triple-M candle) remains unimplemented — anatomy still undefined in the transcripts.
strategy("3M ELITE v4 — Type 2 validation + protected stop + zone invalidation", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

maxBreakHi = input.int(6,    "Max breaks on bias/zone/structure")
maxBreakEn = input.int(4,    "Max breaks on the entry timeframe")
kcMult     = input.float(2.0,"Keltner width for overextension, x ATR")
slopeLen   = input.int(10,   "Bars used for MA slope")
zoneTolK   = input.float(0.25,"Zone tap tolerance, x atr(30)")
bufK       = input.float(0.25,"Protected-stop buffer, x atr(30)")
tpATR      = input.float(12.0,"Take profit, x ATR (source's ATR method)")
minRpct    = input.float(0.80,"Min risk as % of price")
maxRpct    = input.float(3.00,"Max risk as % of price")
maxBars    = input.int(1440, "Max bars in trade")

MS3M  = 180000
MS48M = 2880000
MS3H  = 10800000
MS12H = 43200000

b3   = math.floor(time / MS3M)
b48  = math.floor(time / MS48M)
b3h  = math.floor(time / MS3H)
b12h = math.floor(time / MS12H)

new3   = b3   != b3[1]
new48  = b48  != b48[1]
new3h  = b3h  != b3h[1]
new12h = b12h != b12h[1]

// ---------- reconstructed candles: open/high/low, and the previous completed close ----------
var float o3 = na
var float h3 = na
var float l3 = na
var float c3prev = na
var float c3prev2 = na
if new3
    c3prev2 := c3prev
    c3prev  := close[1]
    o3 := open
    h3 := high
    l3 := low
else
    h3 := na(h3) ? high : math.max(h3, high)
    l3 := na(l3) ? low  : math.min(l3, low)

// 48m: tracks open, high and low so both the engulfing test AND the protected low/high are available.
var float o48      = na
var float h48      = na
var float l48      = na
var float o48prev  = na
var float h48prev  = na
var float l48prev  = na
var float o48prev2 = na
var float c48prev  = na
var float c48prev2 = na
if new48
    o48prev2 := o48prev
    c48prev2 := c48prev
    o48prev  := o48
    h48prev  := h48
    l48prev  := l48
    c48prev  := close[1]
    o48 := open
    h48 := high
    l48 := low
else
    h48 := na(h48) ? high : math.max(h48, high)
    l48 := na(l48) ? low  : math.min(l48, low)

// 3H: unchanged shape from v1/v2/v3 — c3hprev is the CLOSE of the just-completed 3H candle,
// which is what "body closes beyond the zone" is judged against.
var float c3hH = na
var float c3hL = na
var float p3hH = na
var float p3hL = na
var float c3hprev = na
var float c3hprev2 = na
if new3h
    c3hprev2 := c3hprev
    c3hprev  := close[1]
    p3hH := c3hH
    p3hL := c3hL
    c3hH := high
    c3hL := low
else
    c3hH := na(c3hH) ? high : math.max(c3hH, high)
    c3hL := na(c3hL) ? low  : math.min(c3hL, low)

var float c12prev = na
var float c12prev2 = na
if new12h
    c12prev2 := c12prev
    c12prev  := close[1]

// ---------- LAYER 1: BIAS (12H) model = two consecutive same-direction closes ----------
biasBull = not na(c12prev) and not na(c12prev2) and c12prev > c12prev2
biasBear = not na(c12prev) and not na(c12prev2) and c12prev < c12prev2

// ---------- LAYER 2: ZONE (3H) model agrees + supply/demand tap ----------
zoneBull = not na(c3hprev) and not na(c3hprev2) and c3hprev > c3hprev2
zoneBear = not na(c3hprev) and not na(c3hprev2) and c3hprev < c3hprev2

atr30 = ta.atr(30)
tol   = na(atr30) ? 0.0 : atr30 * zoneTolK
demandTap = not na(p3hL) and low  <= p3hL + tol
supplyTap = not na(p3hH) and high >= p3hH - tol

// ---------- LAYER 3: STRUCTURE (48m) model agrees (unchanged: two consecutive closes) ----------
structBull = not na(c48prev) and not na(c48prev2) and c48prev > c48prev2
structBear = not na(c48prev) and not na(c48prev2) and c48prev < c48prev2

// ---------- TYPE 2 VALIDATION: engulfing 48m candle in the direction of bias (unchanged from v2/v3) ----------
bull48Body = not na(c48prev) and not na(o48prev) and c48prev > o48prev
bear48Body = not na(c48prev) and not na(o48prev) and c48prev < o48prev
prevBodyHi = not na(o48prev2) and not na(c48prev2) ? math.max(o48prev2, c48prev2) : na
prevBodyLo = not na(o48prev2) and not na(c48prev2) ? math.min(o48prev2, c48prev2) : na
engulfBull = new48 and bull48Body and not na(prevBodyHi) and not na(prevBodyLo) and o48prev <= prevBodyLo and c48prev >= prevBodyHi
engulfBear = new48 and bear48Body and not na(prevBodyHi) and not na(prevBodyLo) and o48prev >= prevBodyHi and c48prev <= prevBodyLo

// state machine: a zone tap ARMS the wait and captures the ZONE'S OWN price bound (new in v4:
// zoneLow/zoneHigh, fixed at arm time — the level that must NOT get a 3H body close beyond it).
// The next qualifying 48m engulfing candle VALIDATES the wait and captures the PROTECTED LOW/HIGH
// (unchanged from v3). A zone-bias flip clears everything, same as v3. NEW: a 3H body close beyond
// the captured zone bound also clears everything (await, valid, protected level, zone bound) —
// this fires whether the zone is still awaiting or already validated, which is exactly the
// source's "immediate re-validation" case when it fires right after a validation.
var bool  awaitLong     = false
var bool  awaitShort    = false
var bool  validLong     = false
var bool  validShort    = false
var float protectedLow  = na
var float protectedHigh = na
var float zoneLow       = na
var float zoneHigh      = na

// arm only on a FRESH tap (not already awaiting or already validated) — same guard as v2/v3.
if zoneBull and demandTap and not awaitLong and not validLong
    awaitLong := true
    zoneLow   := p3hL
if zoneBear and supplyTap and not awaitShort and not validShort
    awaitShort := true
    zoneHigh   := p3hH

if awaitLong and engulfBull
    validLong    := true
    awaitLong    := false
    protectedLow := l48prev
if awaitShort and engulfBear
    validShort    := true
    awaitShort    := false
    protectedHigh := h48prev

// ZONE INVALIDATION (new in v4): judged on the zone's own timeframe (3H) — a completed 3H candle
// whose close breaches the captured zone bound kills the zone, whether it was awaiting or valid.
if new3h and (awaitLong or validLong) and not na(zoneLow) and c3hprev < zoneLow
    awaitLong    := false
    validLong    := false
    protectedLow := na
    zoneLow      := na
if new3h and (awaitShort or validShort) and not na(zoneHigh) and c3hprev > zoneHigh
    awaitShort    := false
    validShort    := false
    protectedHigh := na
    zoneHigh      := na

if not zoneBull
    validLong    := false
    awaitLong    := false
    protectedLow := na
    zoneLow      := na
if not zoneBear
    validShort    := false
    awaitShort    := false
    protectedHigh := na
    zoneHigh       := na

// ---------- break counting: a break is a close beyond the prior 20-bar extreme ----------
brkUpLvl = ta.highest(high, 20)[1]
brkDnLvl = ta.lowest(low,  20)[1]
brokeUp  = ta.crossover(close, brkUpLvl)
brokeDn  = ta.crossunder(close, brkDnLvl)
var int upCount = 0
var int dnCount = 0
if brokeUp
    upCount := upCount + 1
    dnCount := 0
if brokeDn
    dnCount := dnCount + 1
    upCount := 0

// ---------- MAs on the entry timeframe ----------
ma20  = ta.ema(close, 20)
ma50  = ta.ema(close, 50)
ma200 = ta.ema(close, 200)

atr14  = ta.atr(14)
kcUp   = ma20 + kcMult * atr14
kcDn   = ma20 - kcMult * atr14
notExtLong  = close < kcUp
notExtShort = close > kcDn

fullyAgainstLong  = ma20 < ma50 and ma50 < ma200
fullyAgainstShort = ma20 > ma50 and ma50 > ma200

maSpreadOk = not na(ma200) and ma200 > 0 and math.abs(ma20 - ma200) / ma200 * 100 < 5.0 and math.abs(ma50 - ma200) / ma200 * 100 < 5.0

slope20Up = not na(ma20[slopeLen]) and ma20 > ma20[slopeLen]
slope50Up = not na(ma50[slopeLen]) and ma50 > ma50[slopeLen]
slope20Dn = not na(ma20[slopeLen]) and ma20 < ma20[slopeLen]
slope50Dn = not na(ma50[slopeLen]) and ma50 < ma50[slopeLen]
slopeOkLong  = slope20Up or slope50Up
slopeOkShort = slope20Dn or slope50Dn

// ---------- the gated cascade — unchanged from v2/v3 ----------
longStack  = biasBull and zoneBull and structBull and validLong  and notExtLong  and not fullyAgainstLong  and maSpreadOk and slopeOkLong  and upCount <= maxBreakEn and dnCount <= maxBreakHi
shortStack = biasBear and zoneBear and structBear and validShort and notExtShort and not fullyAgainstShort and maSpreadOk and slopeOkShort and dnCount <= maxBreakEn and upCount <= maxBreakHi

goLong  = longStack  and new3 and close > o3
goShort = shortStack and new3 and close < o3

// ---------- risk: PROTECTED LOW/HIGH stop (unchanged from v3), ATR take profit per the source ----------
buf  = na(atr30) ? 0.0 : atr30 * bufK
minR = close * minRpct / 100
maxR = close * maxRpct / 100

rawLongR  = na(protectedLow)  ? na : close - (protectedLow  - buf)
rawShortR = na(protectedHigh) ? na : (protectedHigh + buf) - close
longR     = na(rawLongR)  ? na : math.min(math.max(rawLongR,  minR), maxR)
shortR    = na(rawShortR) ? na : math.min(math.max(rawShortR, minR), maxR)

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

flat = strategy.position_size == 0

if flat and goLong and not na(longR) and longR > 0
    strategy.entry("L", strategy.long)
    slPx   := close - longR
    tpPx   := close + atr14 * tpATR
    barsIn := 0
else if flat and goShort and not na(shortR) and shortR > 0
    strategy.entry("S", strategy.short)
    slPx   := close + shortR
    tpPx   := close - atr14 * tpATR
    barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1
if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(biasBull ? 1 : biasBear ? -1 : 0,     title="Bias12H")
plot(zoneBull ? 1 : zoneBear ? -1 : 0,     title="Zone3H")
plot(structBull ? 1 : structBear ? -1 : 0, title="Struct48m")
plot(validLong  ? 1 : 0,                   title="ValidLong")
plot(validShort ? 1 : 0,                   title="ValidShort")
plot(upCount,                              title="BreaksUp")
plot(dnCount,                              title="BreaksDown")
