//@version=6
// 3M ELITE v53 — THE SHORT LEG, BUILT FROM THE SOURCE'S OWN WORDS. SUPPLY ZONE, EXACT MIRROR.
//
// USER DIRECTIVE, 2026-09-03: "my 3M and War Formation should work in both directions... they should
// work on both long and shorting, just look over the information I provided for that."
//
// SO I WENT BACK TO THE TRANSCRIPTS, AND THE SOURCE ANSWERS THE QUESTION DIRECTLY.
//   transcripts/2026-08-09 04-18-22.txt [06:19]:
//     "all these advance models are the same thing on the bearish side JUST UPSIDE DOWN, so one two
//      one would be one down two up one down"
//   and [05:12]: "the model is just going to be the same thing that the hard time frame is"
//
// THIS OVERTURNS HOW THIS LAB HAS BEEN READING LESSON 6 FOR THIS STRATEGY. The rule "never mirror
// the short off the long" was earned in the BTC and War Formation labs, and it was then imported
// here as if it were universal. It is not: 3M's OWN SOURCE MATERIAL SPECIFIES A MIRROR. The mandate
// correction is explicit that implementing a decoded-but-unimplemented source definition outranks
// inventing another geometry — and v34, the one previous supply-zone attempt (PF 0.736), was an
// INVENTED fade-into-the-zone construction, NOT this mirror. So this is not attempt seven at the same
// idea; it is the first attempt at what the source actually describes.
//
// WHAT IT IS, PRECISELY. The exact structural mirror of the v37 CHAMPION — the only split-tested
// result in this project (PF 1.25172059 / DD 8.72815312% / 155 trades; H1 1.33630490 / H2 1.12058245;
// cold-reproduced digit-for-digit as v52). Not a mirror of some older long build: a mirror of the
// verified one.
//   long  : 4H BULLISH engulf -> demand zone [pL, pO], tap DOWN into it, stop at dzBot = pL
//   short : 4H BEARISH engulf -> supply zone [pO, pH], tap UP   into it, stop at szTop = pH
// `bearEngulf` was ALREADY COMPUTED IN v37 AND NEVER USED. The champion has been carrying half of
// its own short leg, unwired, this entire time.
//
// EVERY OTHER PARAMETER IS HELD AT v37 EXACTLY — rTarget 2.0, maxBars 96, maxAge 6, minRpct 0.80,
// the two-touch invalidation, the one-entry-per-zone latch. Nothing is tuned for the short side. If
// it needs tuning to work, that is a finding, not a starting point.
//
// AUDIT, one line per leg:
//   R >= 0.8% (LESSON 3) — enforced by EXCLUSION (rBig), never by clamping, so the stop stays on the
//        zone edge. Identical treatment to the long.
//   Stop beyond STRUCTURE (LESSON 5) — szTop = the supply candle's HIGH, the far edge of the zone
//        being defended, not the signal level.
//   Each leg separately (LESSON 6) — SHORT ONLY in this build, judged alone on its own profit factor
//        against v34's 0.736. AND THE 3M-SPECIFIC WARNING IS REGISTERED: v24 showed removing shorts
//        ADDED 84 long entries, so the legs are NOT independent here. A combined build is therefore
//        NOT the sum of these two runs and must be measured separately when it is built.
//   BINDING (E17) — bearEngulf must produce a comparable number of zones to bullEngulf. If the count
//        lands far below the long's 155, the engulfing definition is asymmetric on this instrument
//        and that asymmetry, not the trade logic, is the first thing to examine.
//   REDUNDANCY (E14) — the terms are v37's, already measured on the long side; nothing new is added,
//        so no new redundancy is introduced.
//   LATCH IN SEQUENCE (LESSON 8) — the zone is created only from COMPLETED 4H candles (pO/pH/pC and
//        ppO/ppC), dzAge >= 1 forces at least one further 4H candle before entry, and the tap fires
//        on a later 15m bar. Setup and trigger cannot share a bar.
//   SL and TP FIXED AT ENTRY. No trailing, no averaging down, no martingale. 3M KEEPS ITS OWN MODEL:
//        the War Formation ALCM dollar shield is NOT ported here.
//
// OUT-OF-SAMPLE STATUS, STATED HONESTLY: the full 4.7-year window is used, and unlike the long leg
// this is NOT a blend of tuned and untuned data (HARD LESSON 22) — the short side has never been
// fitted on ANY of it. Every parameter came from the long leg. So this run is genuinely out of
// sample for the short, which is why the aggregate is legitimate here and would not be on the long.
//
// OUTCOMES REGISTERED BEFORE THE RUN (LESSON 17):
//   * PF >= 1.0 with >= 30 trades -> the short leg EXISTS, the source's mirror rule is correct, and
//     3M becomes the project's first genuinely bidirectional strategy. It is then SPLIT-TESTED
//     before any keep — a headline alone does not promote it.
//   * PF < 1.0 -> the mirror hypothesis is closed SPECIFICALLY, which is worth more than another
//     invented geometry failing vaguely: it would mean the source's "upside down" symmetry does not
//     survive contact with this instrument, and the next question is the BIAS GATE the source keeps
//     insisting on ("the model is the same thing the hard time frame is") which v37 does not
//     implement on EITHER leg.
//   * fewer than 30 trades -> below RATCHET v2 clause 3; a DIRECTION, not a result (LESSON 12).
strategy("3M ELITE v53 supply-zone SHORT mirror", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

rTarget  = input.float(2.0, "Target, x R -- held at v37")
maxBars  = input.int(96,    "Max bars in trade -- held at v37")
maxAge   = input.int(6,     "Zone freshness cap, 4H candles since creation -- held at v37")
minRpct  = input.float(0.80,"Min stop distance as % of price (LESSON 3) -- held at v37")

MS4H = 14400000
b4h  = math.floor(time / MS4H)
new4h = b4h != b4h[1]

var float o4 = na
var float h4 = na
var float l4 = na

var float pO  = na
var float pH  = na
var float pL  = na
var float pC  = na
var float ppO = na
var float ppC = na

if new4h and not na(o4)
    ppO := pO
    ppC := pC
    pO  := o4
    pH  := h4
    pL  := l4
    pC  := close[1]

if new4h
    o4 := open
    h4 := high
    l4 := low
else
    h4 := na(h4) ? high : math.max(h4, high)
    l4 := na(l4) ? low  : math.min(l4, low)

bearEngulf = not na(ppO) and not na(ppC) and not na(pO) and not na(pC) and ppC > ppO and pC < pO and pC < ppO

var float szTop   = na
var float szBot   = na
var bool  szLive  = false
var int   szTouch = 0
var int   szAge   = 0
var bool  szTraded = false

if new4h
    if szLive and not na(pC) and pC >= szBot
        szTouch := szTouch + 1
        if szTouch >= 2
            szLive := false
    if szLive
        szAge := szAge + 1
    if bearEngulf
        szBot   := pO
        szTop   := pH
        szLive  := true
        szTouch := 0
        szAge   := 0
        szTraded := false

minR    = close * minRpct / 100
rBig    = not na(szTop) and (szTop - close) >= minR

shortCond = rBig and szLive and not szTraded and szAge >= 1 and szTouch < 2 and high >= szBot and close < szTop and szAge <= maxAge

flat = strategy.position_size == 0

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

if flat and shortCond and not na(szTop) and close < szTop
    r = szTop - close
    if r > 0
        strategy.entry("S", strategy.short)
        szTraded := true
        slPx   := szTop
        tpPx   := close - r * rTarget
        barsIn := 0

if strategy.position_size < 0
    strategy.exit("SX", from_entry="S", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(szLive ? 1 : 0, title="SupplyZoneLive")
plot(szAge,          title="SupplyZoneAge")
