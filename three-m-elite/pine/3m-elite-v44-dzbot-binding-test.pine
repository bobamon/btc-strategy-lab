//@version=6
// 3M ELITE v44 - BINDING TEST: close > dzBot removed from BOTH occurrences.
//   PF/DD/trades recorded in three-m-elite/results/backtests.json (id 3m-elite-v44-dzbot-binding-test)
//   15m, 2022-01-01 -> 2026-09-01 (4.7 years), BTCUSDT, long-only
//
// PURPOSE: last untested signal term, open since v36, flagged again at v37/v38, v39, v40/v41, v42/v43.
// `close > dzBot` appears TWICE in v37 -- once inside longCond, once again in the entry guard -- so
// removing it from longCond alone (as v43 did for dzAge >= 1) would not isolate anything; the second
// occurrence would still gate every entry. This file removes both.
//
// PRE-RUN AUDIT (HARD LESSON 17 -- state the outcome meaning BEFORE running):
//   R floor 0.8% unchanged (LESSON 3). Stop = dzBot, structural, unchanged (LESSON 5). Long only,
//   unchanged (LESSON 6) -- this is a single-leg term test, no mirroring involved.
//   BINDING (E17): this run IS the binding test.
//   REDUNDANCY (E14) -- PREDICTED, stated before running: rBig = (close - dzBot) >= minR, and
//   minR = close * minRpct/100 with minRpct fixed at 0.80 (> 0 for any positive price). So rBig
//   ALREADY entails close - dzBot >= minR > 0, i.e. close > dzBot, as a strict mathematical
//   consequence -- not an empirical claim about this data, an algebraic one about this code. rBig is
//   required in longCond both before and after this change. PREDICTION: removing the explicit
//   `close > dzBot` checks changes NOTHING -- byte-identical 155 trades, PF 1.25172059, DD 8.72815312%
//   to v37. If the real number differs from that prediction, the algebra above is wrong somewhere and
//   the term does independent work -- that would itself be the finding.
strategy("3M ELITE v44 dzBot binding test (both occurrences removed)", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

rTarget  = input.float(2.0, "Target, x R")
maxBars  = input.int(96,    "Max bars in trade (entry timeframe)")
maxAge   = input.int(6,     "Zone freshness cap, 4H candles since creation")
minRpct  = input.float(0.80,"Min stop distance as % of price (LESSON 3)")

MS4H = 14400000
b4h  = math.floor(time / MS4H)
new4h = b4h != b4h[1]

// ---------- reconstruct the 4H candle from 15m bars: in-progress OHLC ----------
var float o4 = na
var float h4 = na
var float l4 = na

// ---------- snapshots of the two most recently COMPLETED 4H candles (open + close; +H/L for the most recent) ----------
var float pO  = na
var float pH  = na
var float pL  = na
var float pC  = na
var float ppO = na
var float ppC = na

if new4h and not na(o4)
    ppO := pO
    ppC := pC
    pO  := o4
    pH  := h4
    pL  := l4
    pC  := close[1]

if new4h
    o4 := open
    h4 := high
    l4 := low
else
    h4 := na(h4) ? high : math.max(h4, high)
    l4 := na(l4) ? low  : math.min(l4, low)

// ---------- engulf on the just-completed candle vs the one before it (body containment, no gap) ----------
bullEngulf = not na(ppO) and not na(ppC) and not na(pO) and not na(pC) and ppC < ppO and pC > pO and pC > ppO
bearEngulf = not na(ppO) and not na(ppC) and not na(pO) and not na(pC) and ppC > ppO and pC < pO and pC < ppO

// ---------- demand zone lifecycle: create on bull engulf, mitigate on a body close inside, age in 4H units ----------
var float dzTop   = na
var float dzBot   = na
var bool  dzLive  = false
var int   dzTouch = 0
var int   dzAge   = 0
var bool  dzTraded = false

if new4h
    if dzLive and not na(pC) and pC <= dzTop
        dzTouch := dzTouch + 1
        if dzTouch >= 2
            dzLive := false
    if dzLive
        dzAge := dzAge + 1
    if bullEngulf
        dzTop   := pO
        dzBot   := pL
        dzLive  := true
        dzTouch := 0
        dzAge   := 0
        dzTraded := false

// ---------- entry: zone live, sequenced after creation, not yet double-mitigated, price back at the zone, still fresh ----------
// close > dzBot REMOVED from both this conjunction and the entry guard below -- the term under test.
minR    = close * minRpct / 100
rBig    = not na(dzBot) and (close - dzBot) >= minR

longCond = rBig and dzLive and not dzTraded and dzAge >= 1 and dzTouch < 2 and low <= dzTop and dzAge <= maxAge

flat = strategy.position_size == 0

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

if flat and longCond and not na(dzBot)
    r = close - dzBot
    if r > 0
        strategy.entry("L", strategy.long)
        dzTraded := true
        slPx   := dzBot
        tpPx   := close + r * rTarget
        barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(dzLive ? 1 : 0, title="DemandZoneLive")
plot(dzAge,          title="DemandZoneAge")
