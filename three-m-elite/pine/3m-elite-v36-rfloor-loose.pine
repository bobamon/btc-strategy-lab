//@version=6
// 3M ELITE v36 - R-FLOOR NEIGHBOURHOOD, LOOSE SIDE (minRpct=0.50)
//   Queue item 1 from v35: v35 measured the TIGHT side (1.20%) and found a real interior optimum
//   at v32's 0.80%. This measures the LOOSE side to complete HARD LESSON 16's "both neighbours"
//   requirement. v31's minRpct=0 is the fully-open end, not a neighbourhood point next to 0.80.
//
// ONE CHANGE from pine/3m-elite-v32-r-floor.pine: minRpct 0.80 -> 0.50. Nothing else moves.
//
//   minRpct=0    (v31)  PF 0.88869052 | DD 34.63598596% | 734 trades | 37.60% win
//   minRpct=0.50 (v36)  <-- this run
//   minRpct=0.80 (v32)  PF 1.22482256 | DD 10.90593093% | 165 trades | 42.42% win  <- champion
//   minRpct=1.20 (v35)  PF 1.09260420 | DD 16.58968851% | 67  trades | 38.81% win
//
// If PF falls and DD rises relative to v32 (continuing the v35 pattern on the other side), the
// three-plus-one-point curve confirms a genuine interior optimum, not a monotone ratio-for-sample
// walk (the cross-lab coolBars warning) and not a curve-fit spike (HARD LESSON 16). If instead PF
// or DD IMPROVE on v32 with a comparable trade count, 0.80% is not actually the peak and this
// becomes the new candidate.
//
// AUDIT: identical to v32 in every other respect. LONG ONLY (LESSON 6, legs not independent in
// this lab). Stop = dzBot, structural (LESSON 5). SL/TP fixed at entry (LESSON per project rules).
// BINDING: to be read from the trade count vs v32's 165. REDUNDANCY: none -- this IS the isolated
// variable per HARD LESSON 16.
strategy("3M Elite v36 R-floor neighbourhood loose", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

rTarget  = input.float(2.0, "Target, x R")
maxBars  = input.int(96,    "Max bars in trade (entry timeframe)")
maxAge   = input.int(12,    "Zone freshness cap, 4H candles since creation")
minRpct  = input.float(0.50,"THE ONE CHANGE: min stop distance as % of price (LESSON 3), loose side")

MS4H = 14400000
b4h  = math.floor(time / MS4H)
new4h = b4h != b4h[1]

// ---------- reconstruct the 4H candle from 15m bars: in-progress OHLC ----------
var float o4 = na
var float h4 = na
var float l4 = na

// ---------- snapshots of the two most recently COMPLETED 4H candles (open + close; +H/L for the most recent) ----------
var float pO  = na
var float pH  = na
var float pL  = na
var float pC  = na
var float ppO = na
var float ppC = na

if new4h and not na(o4)
    ppO := pO
    ppC := pC
    pO  := o4
    pH  := h4
    pL  := l4
    pC  := close[1]

if new4h
    o4 := open
    h4 := high
    l4 := low
else
    h4 := na(h4) ? high : math.max(h4, high)
    l4 := na(l4) ? low  : math.min(l4, low)

// ---------- engulf on the just-completed candle vs the one before it (body containment, no gap) ----------
bullEngulf = not na(ppO) and not na(ppC) and not na(pO) and not na(pC) and ppC < ppO and pC > pO and pC > ppO
bearEngulf = not na(ppO) and not na(ppC) and not na(pO) and not na(pC) and ppC > ppO and pC < pO and pC < ppO

// ---------- demand zone lifecycle: create on bull engulf, mitigate on a body close inside, age in 4H units ----------
var float dzTop   = na
var float dzBot   = na
var bool  dzLive  = false
var int   dzTouch = 0
var int   dzAge   = 0
var bool  dzTraded = false   // v31: one entry per zone

if new4h
    // mitigation check on the candle that just completed, against the zone as it stood BEFORE this candle
    if dzLive and not na(pC) and pC <= dzTop
        dzTouch := dzTouch + 1
        if dzTouch >= 2
            dzLive := false
    if dzLive
        dzAge := dzAge + 1
    // most-recent engulf always creates/replaces the zone (v23 — no "deepest" ratchet)
    if bullEngulf
        dzTop   := pO
        dzBot   := pL
        dzLive  := true
        dzTouch := 0
        dzAge   := 0
        dzTraded := false        // v31: a NEW zone is tradeable again

// ---------- entry: zone live, sequenced after creation, not yet double-mitigated, price back at the zone, still fresh ----------
minR    = close * minRpct / 100
rBig    = not na(dzBot) and (close - dzBot) >= minR   // THE ONE CHANGE

longCond = rBig and dzLive and not dzTraded and dzAge >= 1 and dzTouch < 2 and low <= dzTop and close > dzBot and dzAge <= maxAge

flat = strategy.position_size == 0

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

if flat and longCond and not na(dzBot) and close > dzBot
    r = close - dzBot
    if r > 0
        strategy.entry("L", strategy.long)
        dzTraded := true         // v31: latch -- this zone is now spent
        slPx   := dzBot
        tpPx   := close + r * rTarget
        barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(dzLive ? 1 : 0, title="DemandZoneLive")
plot(dzAge,          title="DemandZoneAge")
