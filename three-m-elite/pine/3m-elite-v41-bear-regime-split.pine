//@version=6
// 3M ELITE v41 - BEAR-REGIME SPLIT. BYTE-IDENTICAL to v37 (3m-elite-v37-freshness-tight.pine).
//   Only the backtest window changed: isolated 2022-01-01 -> 2022-12-31, the one full calendar
//   year in this project's data coverage that is unambiguously a bear market (BTC ~$47k -> ~$16.5k).
//   PF/DD/trades recorded in three-m-elite/results/backtests.json (id 3m-elite-v41-bear-regime-split)
//   15m, BTCUSDT, long-only
//
// PURPOSE: queue item 2 from v36/v37/v38/v39 -- a PURPOSE-BUILT bear-market split, distinct from the
// time-based halves (v28a/b, v33, v39's H1/H2) which all blend the 2022 crash with the 2023-2024
// recovery. This isolates the falling year alone to give the STANDING REQUIREMENT's "both regimes"
// clause its first real bear-only evidence in this lab.
//
// AUDIT: LONG ONLY, unchanged from v37 (LESSON 6). Stop = dzBot, structural (LESSON 5). R floor 0.8%
// unchanged (LESSON 3). SL/TP fixed at entry. Source code is IDENTICAL to v37 -- no parameter changed,
// only the from/to window narrowed at the backtest call.
strategy("3M ELITE v37 freshness tight (maxAge=6)", overlay=true,
     pyramiding=1, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.05,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     margin_long=100, margin_short=100)

rTarget  = input.float(2.0, "Target, x R")
maxBars  = input.int(96,    "Max bars in trade (entry timeframe)")
maxAge   = input.int(6,     "Zone freshness cap, 4H candles since creation -- THE ONE CHANGE (12 -> 6)")
minRpct  = input.float(0.80,"Min stop distance as % of price (LESSON 3)")

MS4H = 14400000
b4h  = math.floor(time / MS4H)
new4h = b4h != b4h[1]

var float o4 = na
var float h4 = na
var float l4 = na

var float pO  = na
var float pH  = na
var float pL  = na
var float pC  = na
var float ppO = na
var float ppC = na

if new4h and not na(o4)
    ppO := pO
    ppC := pC
    pO  := o4
    pH  := h4
    pL  := l4
    pC  := close[1]

if new4h
    o4 := open
    h4 := high
    l4 := low
else
    h4 := na(h4) ? high : math.max(h4, high)
    l4 := na(l4) ? low  : math.min(l4, low)

bullEngulf = not na(ppO) and not na(ppC) and not na(pO) and not na(pC) and ppC < ppO and pC > pO and pC > ppO
bearEngulf = not na(ppO) and not na(ppC) and not na(pO) and not na(pC) and ppC > ppO and pC < pO and pC < ppO

var float dzTop   = na
var float dzBot   = na
var bool  dzLive  = false
var int   dzTouch = 0
var int   dzAge   = 0
var bool  dzTraded = false

if new4h
    if dzLive and not na(pC) and pC <= dzTop
        dzTouch := dzTouch + 1
        if dzTouch >= 2
            dzLive := false
    if dzLive
        dzAge := dzAge + 1
    if bullEngulf
        dzTop   := pO
        dzBot   := pL
        dzLive  := true
        dzTouch := 0
        dzAge   := 0
        dzTraded := false

minR    = close * minRpct / 100
rBig    = not na(dzBot) and (close - dzBot) >= minR

longCond = rBig and dzLive and not dzTraded and dzAge >= 1 and dzTouch < 2 and low <= dzTop and close > dzBot and dzAge <= maxAge

flat = strategy.position_size == 0

var float slPx   = na
var float tpPx   = na
var int   barsIn = 0

if flat and longCond and not na(dzBot) and close > dzBot
    r = close - dzBot
    if r > 0
        strategy.entry("L", strategy.long)
        dzTraded := true
        slPx   := dzBot
        tpPx   := close + r * rTarget
        barsIn := 0

if strategy.position_size > 0
    strategy.exit("LX", from_entry="L", stop=slPx, limit=tpPx)
    barsIn := barsIn + 1

if barsIn >= maxBars and strategy.position_size != 0
    strategy.close_all()
    barsIn := 0

plot(dzLive ? 1 : 0, title="DemandZoneLive")
plot(dzAge,          title="DemandZoneAge")
